#!/bin/sh
# SMD Linux 1.0 - enable the services the desktop needs and nothing else.
#
# The image deliberately installs no printing stack, no indexing service, no
# software store, no avahi and no ModemManager, so there is nothing to disable
# here; this hook only makes sure the required units are enabled.
set -e

echo "hunter: enabling services"

for unit in NetworkManager bluetooth lightdm zramswap systemd-timesyncd \
	hunter-graphics hunter-audio-hw; do
	if systemctl enable "${unit}.service" >/dev/null 2>&1 || \
	   systemctl enable "${unit}" >/dev/null 2>&1; then
		echo "hunter:   enabled ${unit}"
	else
		echo "hunter:   warning: could not enable ${unit}" >&2
	fi
done

# PipeWire for every user, enabled globally: the user units ship with the
# package but nothing enables them, so the sound server never started and the
# session had no audio at all.
#
# Activation is by service, not by socket.  Socket activation left
# pipewire.socket in a failed state on the tested images, and a failed socket
# takes pipewire.service with it - the session then had no sound server at all
# even though every package was installed.  The sockets are masked so nothing
# tries them again, and the three services are started at login instead.
for unit in pipewire.socket pipewire-pulse.socket; do
	if systemctl --global mask "${unit}" >/dev/null 2>&1; then
		echo "hunter:   masked (user) ${unit} in favour of the service"
	else
		echo "hunter:   warning: could not mask user unit ${unit}" >&2
	fi
done
for unit in pipewire.service pipewire-pulse.service wireplumber.service; do
	if systemctl --global enable "${unit}" >/dev/null 2>&1; then
		echo "hunter:   enabled (user) ${unit}"
	else
		echo "hunter:   warning: could not enable user unit ${unit}" >&2
	fi
done

# Serial console login.  The kernel command line carries console=ttyS0, but the
# installed system needs its own getty instance; the drop-in in
# serial-getty@ttyS0.service.d keeps it from running on hardware without a
# serial port.  This is also how the automated tests log in after installation.
if systemctl enable serial-getty@ttyS0.service >/dev/null 2>&1; then
	echo "hunter:   enabled serial-getty@ttyS0"
else
	echo "hunter:   warning: could not enable serial-getty@ttyS0" >&2
fi
