#!/bin/sh
# Hunter Linux 1.0 - desktop wiring inside the chroot.
set -e

echo "hunter: configuring desktop files"

# i3 falls back to /etc/i3/config when a user has no configuration of their own
# (for example the root account on a console login).  Edit the file in
# /etc/skel/.config/i3/config - this copy is derived from it.
mkdir -p /etc/i3
cp -f /etc/skel/.config/i3/config /etc/i3/config

# Empty home directories so a new user starts with the usual folders even
# before xdg-user-dirs-update runs.
mkdir -p /etc/skel/Desktop /etc/skel/Downloads /etc/skel/Documents \
	/etc/skel/Music /etc/skel/Pictures /etc/skel/Videos

# Permissions
chmod 0755 /usr/local/bin/hunter-session /usr/local/bin/hunter-power \
	/usr/local/bin/hunter-install
chmod 0755 /usr/local/sbin/hunter-postinstall /usr/local/sbin/hunter-bootloader
chmod 0644 /usr/share/xsessions/hunter.desktop
chmod 0644 /usr/share/applications/hunter-install.desktop \
	/usr/share/applications/hunter-power.desktop \
	/usr/share/applications/hunter-shortcuts.desktop
# Desktop icons must be executable for XFCE to trust and launch them.
chmod 0755 /etc/skel/Desktop/hunter-install.desktop \
	/etc/skel/Desktop/hunter-shortcuts.desktop
chmod 0440 /etc/sudoers.d/90-hunter-live

# Icon and menu caches
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database -q /usr/share/applications || true
fi
