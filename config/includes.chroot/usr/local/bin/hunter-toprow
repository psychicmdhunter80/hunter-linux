#!/bin/sh
# SMD Linux - make the Chromebook top row do what its symbols say.
#
# On a Chromebook the top row is not F1-F12: the keys are printed as
# back / forward / reload / fullscreen / next-tab / dimmer / brighter / mute /
# volume down / volume up, but the firmware and the kernel deliver F1-F10.  So
# the printed volume and brightness keys arrive in X as F8, F9, F10, F6 and F7,
# and no XF86 media keysym is ever produced - which is why the existing
# XF86Audio* and XF86MonBrightness* bindings in the i3 configuration never
# fired on Hunter's Acer CB3-111.
#
# This script writes the i3 bindings for that layout into
# ~/.config/i3/toprow.conf, which the i3 configuration includes, and it only
# does so on hardware that actually is a Chromebook (DMI says the vendor is
# GOOGLE or the product name mentions Chromebook).  On an ordinary PC the file
# is left empty, so a normal keyboard keeps all of its F keys and the XF86
# bindings still work.
#
# Ctrl plus the same key is kept as the secondary way to reach the real F key,
# as Hunter suggested: Ctrl+F9 sends F9 to the focused application instead of
# lowering the volume.

set -u

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
flag="$config_home/i3/chromebook-keys"
mkdir -p "$config_home/i3" 2>/dev/null || exit 0

detect() {
	vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
	product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
	board=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
	text="$vendor $product $board"
	case "$text" in
	*GOOGLE*|*Google*|*Chromebook*|*chromebook*|*Chromium*) return 0 ;;
	esac
	return 1
}

# --force is only used by the VM tests, which cannot pretend to be a Chromebook
# at the firmware level.
if [ "${1:-}" = "--force" ]; then
	chromebook=1
elif detect; then
	chromebook=1
else
	chromebook=0
fi

# The i3 configuration always binds the five keys and calls hunter-media, so it
# needs no include and no reload.  This file is the switch: present means "this
# is a Chromebook, do the printed thing", absent means "pass the F key on".
if [ "$chromebook" = 1 ]; then
	printf 'Chromebook top row: volume, mute and brightness act on these keys.\n' \
		>"$flag"
else
	rm -f "$flag"
fi

exit 0
