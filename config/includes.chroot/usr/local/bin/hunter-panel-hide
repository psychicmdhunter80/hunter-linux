#!/bin/sh
# SMD Linux - make the panel hide and reveal under i3.
#
# Why this exists: xfce4-panel's own auto-hide works by asking the window
# manager to move the panel off screen.  i3 refuses to move dock windows - its
# log says "Dock client will not be moved, we only support moving it to another
# output" - and then reports the panel as still visible, so the panel can never
# hide.  That is i3 issue 4153 and xfce4-panel issue 308, both open.  The panel
# XML still says autohide-behavior=2, but on i3 that value alone does nothing.
#
# This helper does the hiding itself: the panel keeps its place at the bottom
# edge and is unmapped when the pointer is away from it, and mapped again when
# the pointer reaches the edge.  "gaps bottom 28" in the i3 configuration
# reserves the space, so windows neither jump when the panel disappears nor end
# up underneath it.  The panel stays on screen whenever the pointer is over it
# or over one of its own windows - a menu, the whisker menu - so clicking
# through a menu does not make it vanish mid-click.
#
# One copy only: started from the i3 configuration with exec_always, so an i3
# reload cannot leave a second watcher behind.

set -u

cache="${XDG_CACHE_HOME:-$HOME/.cache}/smd"
mkdir -p "$cache" 2>/dev/null || exit 0
log="$cache/panel-hide.log"

exec 9>"$cache/panel-hide.lock" || exit 0
if command -v flock >/dev/null 2>&1; then
	flock -n 9 || exit 0
fi

command -v xdotool >/dev/null 2>&1 || {
	echo "$(date '+%F %T') xdotool is missing, the panel stays visible" >>"$log"
	exit 0
}

# How close to the bottom edge the pointer has to be to bring the panel back.
REVEAL=4

# Windows are looked up by the panel's process id: the WM_CLASS spelling is not
# stable ("xfce4-panel" as the instance, "Xfce4-panel" as the class) and xdotool
# matches case-sensitively, which is why the first version found no windows and
# never hid anything.
panel_windows() {
	pid=$(pgrep -x xfce4-panel 2>/dev/null | head -n 1)
	[ -n "$pid" ] || return 0
	xdotool search --pid "$pid" 2>/dev/null
}

echo "$(date '+%F %T') panel watcher started on ${DISPLAY:-?}" >>"$log"

shown=1
ticks=0
while :; do
	# The X server goes away at logout.  Without this the loop would survive the
	# session and keep the lock, so the next login would find it held and start
	# no panel at all - the "panel does not come back" report.
	if ! xset q >/dev/null 2>&1; then
		echo "$(date '+%F %T') display is gone, stopping the watcher" >>"$log"
		exit 0
	fi

	geom=$(xdotool getdisplaygeometry 2>/dev/null) || { sleep 1; continue; }
	screen_h=${geom#* }

	eval "$(xdotool getmouselocation --shell 2>/dev/null)" || { sleep 1; continue; }

	want=0
	if [ "${Y:-0}" -ge $((screen_h - REVEAL)) ]; then
		want=1
	else
		pid=$(pgrep -x xfce4-panel 2>/dev/null | head -n 1)
		if [ -n "${WINDOW:-0}" ] && [ "${WINDOW:-0}" != "0" ] && [ -n "$pid" ]; then
			window_pid=$(xdotool getwindowpid "$WINDOW" 2>/dev/null || true)
			[ "$window_pid" = "$pid" ] && want=1
		fi
	fi

	if [ "$want" = 1 ] && [ "$shown" = 0 ]; then
		for id in $(panel_windows); do
			xdotool windowmap "$id" 2>/dev/null
			xdotool windowraise "$id" 2>/dev/null
		done
		echo "$(date '+%F %T') panel shown" >>"$log"
		shown=1
	elif [ "$want" = 0 ] && [ "$shown" = 1 ]; then
		for id in $(panel_windows); do
			xdotool windowunmap "$id" 2>/dev/null
		done
		count=$(panel_windows | wc -l)
		echo "$(date '+%F %T') panel hidden ($count window(s))" >>"$log"
		shown=0
	fi

	ticks=$((ticks + 1))
	# Keep the log short: one status line a minute is enough to diagnose it.
	if [ $((ticks % 300)) = 1 ]; then
		echo "$(date '+%F %T') alive, $(panel_windows | wc -l) window(s), panel $([ "$shown" = 1 ] && echo shown || echo hidden)" >>"$log"
	fi

	sleep 0.2
done
