#!/bin/sh
# SMD Linux - keep exactly one XFCE panel running under i3.
#
# Started from the i3 configuration with exec_always, so the panel comes up
# with the window manager in the live session and on an installed system,
# regardless of which session file the display manager picked.  i3 may run this
# again on every reload, so the flock makes a second copy exit immediately
# instead of stacking panels.
#
# Output goes to ~/.cache/smd/panel.log: when the panel does fail, the reason
# is on disk instead of being thrown away.

set -u

cache="${XDG_CACHE_HOME:-$HOME/.cache}/smd"
mkdir -p "$cache" 2>/dev/null || exit 0
log="$cache/panel.log"

# One watchdog only, per display: another instance on this X server owns the
# panel and this copy must not start a second one.  The lock is keyed by the
# display so a panel started on :0 can never block :1.
lockname=$(printf '%s' "${DISPLAY:-:0}" | tr ':/' '__')
exec 9>"$cache/panel${lockname}.lock" || exit 0
if command -v flock >/dev/null 2>&1; then
	flock -n 9 || exit 0
fi

[ -s "$log" ] && [ "$(wc -c <"$log")" -gt 100000 ] && : >"$log"

echo "--- $(date '+%F %T') starting panel (DISPLAY=$DISPLAY)" >>"$log"

# Do not react to SIGTERM from an i3 reload by leaving a half-dead panel.
trap 'exit 0' TERM INT

while :; do
	if ! command -v xfce4-panel >/dev/null 2>&1; then
		echo "$(date '+%F %T') xfce4-panel is not installed" >>"$log"
		exit 0
	fi
	xfce4-panel --disable-wm-check >>"$log" 2>&1
	status=$?
	echo "$(date '+%F %T') xfce4-panel exited with $status" >>"$log"
	# At logout the X server takes the panel with it while this loop survives.
	# If that happened, stop here: a leftover watchdog would hold the lock, fail
	# to start a panel without a display and leave the next login with no
	# panel at all - the "panel does not come back" report.
	if ! xset q >/dev/null 2>&1; then
		echo "$(date '+%F %T') display is gone, stopping the watchdog" >>"$log"
		break
	fi
	# A crash loop should not spin the CPU or flood the log.
	sleep 2
done
exit 0
