#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately: left takes the 1st, 3rd, 5th... arrival, right the 2nd, 4th, 6th...

Order is arrival order per workspace, tracked by container id - never by title,
and never by whichever window happened to be focused last.

The helper talks to i3's IPC socket directly: it subscribes to the window
events, asks for the tree, and issues i3's own split/move commands.  The socket
is found from the environment, the runtime directory or i3 itself, so it works
from the session, after an i3 restart, and from a terminal.
"""

import fcntl
import json
import os
import socket
import struct
import sys
import time

SCRATCH = "smd-autotile-scratch"
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")

RUN_COMMAND = 0
SUBSCRIBE = 2
GET_TREE = 4
EVENT_FLAG = 0x80000000


def note(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        try:
            if os.path.getsize(LOG_PATH) > 65536:
                os.truncate(LOG_PATH, 0)
        except OSError:
            pass
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def find_socket():
    for name in ("I3SOCK", "SWAYSOCK"):
        value = os.environ.get(name)
        if value and os.path.exists(value):
            return value
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    candidates = []
    for base, pattern in ((os.path.join(runtime, "i3"), "ipc-socket."),
                          ("/tmp", "i3-")):
        try:
            for entry in os.listdir(base):
                if entry.startswith(pattern):
                    candidates.append(os.path.join(base, entry))
        except OSError:
            pass
    if candidates:
        candidates.sort(key=lambda p: os.path.getmtime(p))
        return candidates[-1]
    return None


class I3:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buffer = b""

    def _send(self, message_type, payload=""):
        data = payload.encode("utf-8")
        self.sock.sendall(b"i3-ipc" + struct.pack("=II", len(data), message_type) + data)

    def _read_exact(self, count):
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def message(self, message_type, payload=""):
        self._send(message_type, payload)
        header = self._read_exact(14)
        if header[:6] != b"i3-ipc":
            raise ValueError("unexpected reply from i3")
        length, reply_type = struct.unpack("=II", header[6:])
        body = self._read_exact(length).decode("utf-8", "replace")
        return reply_type, json.loads(body) if body else None

    def command(self, text):
        _kind, replies = self.message(RUN_COMMAND, text)
        for reply in replies or []:
            if not reply.get("success"):
                note("failed: %s -> %s" % (text, reply.get("error")))

    def tree(self):
        return self.message(GET_TREE)[1]

    def event(self):
        header = self._read_exact(14)
        if header[:6] != b"i3-ipc":
            raise ValueError("unexpected event from i3")
        length, event_type = struct.unpack("=II", header[6:])
        body = self._read_exact(length).decode("utf-8", "replace")
        return event_type, json.loads(body) if body else None


def leaves_of(node, found=None):
    if found is None:
        found = []
    if not isinstance(node, dict):
        return found
    for child in node.get("nodes", []) or []:
        if child.get("window") and not str(child.get("floating", "")).startswith("user") \
                and child.get("type") == "con" and not child.get("nodes"):
            found.append(child)
        else:
            leaves_of(child, found)
    return found


def find_workspace(tree, name):
    for output in tree.get("nodes", []) or []:
        for node in output.get("nodes", []) or []:
            if node.get("type") == "workspace" and node.get("name") == name:
                return node
            for child in node.get("nodes", []) or []:
                if child.get("type") == "workspace" and child.get("name") == name:
                    return child
    return None


def focused_workspace(tree):
    def walk(node):
        if node.get("focused") and node.get("type") == "workspace":
            return node
        for child in node.get("nodes", []) or []:
            hit = walk(child)
            if hit:
                return hit
        return None

    return walk(tree)


def main():
    note("starting")

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    path = find_socket()
    if not path:
        note("no i3 IPC socket found")
        return 1
    i3 = I3(path)
    note("connected to %s" % path)

    order = {}
    state = {"busy": False, "pending": set()}

    def command(text):
        i3.command(text)

    def workspace_names():
        tree = i3.tree()
        names = []
        for output in tree.get("nodes", []) or []:
            for node in output.get("nodes", []) or []:
                if node.get("type") == "workspace":
                    names.append(node.get("name"))
                for child in node.get("nodes", []) or []:
                    if child.get("type") == "workspace":
                        names.append(child.get("name"))
        return names

    def reflow(name):
        tree = i3.tree()
        workspace = find_workspace(tree, name)
        if workspace is None:
            order.pop(name, None)
            return

        current = [c.get("id") for c in leaves_of(workspace)]
        known = [i for i in order.get(name, []) if i in current]
        for con_id in current:
            if con_id not in known:
                known.append(con_id)
        order[name] = known
        ids = known
        if not ids:
            order.pop(name, None)
            return
        if any(c.get("fullscreen_mode") for c in leaves_of(workspace)):
            return

        note("reflow %s order=%s" % (name, ids))

        def mark(con_id):
            return "smd-%d" % con_id

        # Park every window first: nesting from the previous layout cannot leak
        # into the new one, and the workspace is then rebuilt from scratch.
        for con_id in ids:
            command("[con_id=%d] move container to workspace %s"
                    % (con_id, SCRATCH))

        for index, con_id in enumerate(ids):
            if index == 0:
                command("[con_id=%d] move container to workspace %s"
                        % (con_id, name))
                if len(ids) > 1:
                    # Make the workspace horizontal before the second window.
                    command("[con_id=%d] split h" % con_id)
            elif index == 1:
                # Move to the mark, not to the workspace: inserting after a
                # marked window keeps the target's parent, so B lands beside A
                # instead of at the root of an already split workspace.
                command("[con_id=%d] move container to mark %s"
                        % (con_id, mark(ids[0])))
            elif index == 2:
                command("[con_id=%d] split v" % ids[0])
                command("[con_id=%d] move container to mark %s"
                        % (con_id, mark(ids[0])))
            elif index == 3:
                command("[con_id=%d] split v" % ids[1])
                command("[con_id=%d] move container to mark %s"
                        % (con_id, mark(ids[1])))
            else:
                column = ids[index % 2::2]
                previous = [i for i in column if i != con_id]
                target = previous[-1] if previous else ids[index % 2]
                command("[con_id=%d] move container to mark %s"
                        % (con_id, mark(target)))
            command("[con_id=%d] mark --add %s" % (con_id, mark(con_id)))

        # The layout is applied by the commands above; anything after them is
        # diagnostics only and must never be able to stop the helper.
        try:
            final = find_workspace(i3.tree(), name)
            boxes = ["%d" % c["id"] for c in leaves_of(final or {})]
            note("  placed: %s" % " ".join(boxes))
        except Exception as error:  # noqa: BLE001
            note("  (no geometry report: %s)" % error)

    def handle(name):
        if not name or name == SCRATCH:
            return
        if state["busy"]:
            state["pending"].add(name)
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - the helper must not die
            note("error: %s" % error)
        finally:
            state["busy"] = False
        while state["pending"]:
            pending_name = state["pending"].pop()
            state["busy"] = True
            try:
                reflow(pending_name)
            except Exception as error:  # noqa: BLE001
                note("error: %s" % error)
            finally:
                state["busy"] = False

    _kind, _reply = i3.message(
        SUBSCRIBE, json.dumps(["window"]))
    note("subscribed to window events")

    # Whatever is on screen when the helper starts gets the layout once.
    for name in workspace_names():
        handle(name)

    while True:
        try:
            event_type, payload = i3.event()
        except (ConnectionError, ValueError):
            note("connection lost, reconnecting")
            time.sleep(2)
            path = find_socket()
            if not path:
                return 1
            i3 = I3(path)
            i3.message(SUBSCRIBE, json.dumps(["window"]))
            for name in workspace_names():
                handle(name)
            continue
        if not isinstance(payload, dict):
            continue
        change = payload.get("change")
        if change in ("new", "close", "fullscreen_mode"):
            # A brand-new window is not in the tree yet and a closed one is
            # already gone, so the focused workspace is the one to rebuild.
            tree = i3.tree()
            workspace = focused_workspace(tree)
            handle(workspace.get("name") if workspace else None)
        elif change == "move":
            for name in workspace_names():
                handle(name)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - keep the failure where it can be read
        import traceback
        note("fatal: " + traceback.format_exc().replace("\n", " | "))
        raise
