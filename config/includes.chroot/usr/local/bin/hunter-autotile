#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately: left takes arrival 1st, 3rd, 5th..., right the 2nd, 4th, 6th...

Order is arrival order per workspace, tracked by container id - never by title,
and never by whichever window happened to be focused last, which is what a
generic "split the active window" script gets wrong.

The structure is built with i3's own layout mechanism: the windows are parked
on a scratch workspace, a layout with one marked placeholder per slot is
appended to the target workspace, and each window is moved onto its slot's mark.
Moving to a mark inserts the window directly after that placeholder inside the
placeholder's parent, so the column a window lands in is decided by the layout,
not by focus.  The placeholders are removed afterwards.
"""

import fcntl
import glob
import json
import os
import subprocess
import sys
import tempfile
import time

SCRATCH = "smd-autotile-scratch"
SLOT_PREFIX = "smd-slot-"
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")


def note(message):
    # getsize() on a file that does not exist yet raises, which silently threw
    # away the first line - and with it every later one.
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        try:
            if os.path.getsize(LOG_PATH) > 65536:
                os.truncate(LOG_PATH, 0)
        except OSError:
            pass
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def placeholder(index):
    return {
        "type": "con",
        "name": "smd-slot",
        "border": "none",
        "marks": ["%s%d" % (SLOT_PREFIX, index)],
        "swallows": [],
    }


def build_layout(count):
    """The workspace layout for `count` windows."""
    if count <= 2:
        return {
            "type": "con",
            "name": "smd-autotile",
            "layout": "splith",
            "nodes": [placeholder(i) for i in range(count)],
        }
    left = [i for i in range(count) if i % 2 == 0]
    right = [i for i in range(count) if i % 2 == 1]
    return {
        "type": "con",
        "name": "smd-autotile",
        "layout": "splith",
        "nodes": [
            {"type": "con", "name": "smd-left", "layout": "splitv",
             "percent": 0.5, "nodes": [placeholder(i) for i in left]},
            {"type": "con", "name": "smd-right", "layout": "splitv",
             "percent": 0.5, "nodes": [placeholder(i) for i in right]},
        ],
    }


def find_socket():
    """Locate i3's IPC socket.

    i3ipc's own lookup needs the environment i3 hands to its children, and the
    helper also has to survive an i3 restart, so the socket is resolved here
    from the environment, the runtime directory and finally i3 itself.
    """
    for name in ("I3SOCK", "SWAYSOCK"):
        value = os.environ.get(name)
        if value and os.path.exists(value):
            return value

    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    candidates = []
    for pattern in (os.path.join(runtime, "i3", "ipc-socket.*"),
                    "/tmp/i3-*/ipc-socket.*"):
        candidates.extend(glob.glob(pattern))
    if candidates:
        candidates.sort(key=os.path.getmtime)
        return candidates[-1]

    try:
        out = subprocess.check_output(
            ["i3", "--get-socketpath"], stderr=subprocess.DEVNULL,
            env=dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0")))
        return out.decode().strip() or None
    except (OSError, subprocess.CalledProcessError):
        return None


def main():
    try:
        import i3ipc
    except ImportError:
        note("python3-i3ipc is missing")
        return 1

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    path = find_socket()
    if not path:
        note("no i3 IPC socket found")
        return 1
    note("using socket %s" % path)
    try:
        i3 = i3ipc.Connection(socket_path=path, auto_reconnect=True)
    except TypeError:
        # older i3ipc releases name the argument differently
        i3 = i3ipc.Connection(path)
    order = {}
    state = {"busy": False, "pending": set()}

    def leaves(workspace):
        found = []

        def walk(node):
            for child in node.nodes or []:
                if child.type == "con" and child.window and not child.floating:
                    found.append(child)
                elif child.type in ("con", "workspace", "output", "root"):
                    walk(child)

        walk(workspace)
        return found

    def workspace_of(tree, name):
        for workspace in tree.workspaces():
            if workspace.name == name:
                return workspace
        return None

    def sync_order(name, workspace):
        current = [c.id for c in leaves(workspace)] if workspace else []
        known = [i for i in order.get(name, []) if i in current]
        for con_id in current:
            if con_id not in known:
                known.append(con_id)
        order[name] = known
        return known

    def command(text):
        for item in i3.command(text):
            if not item.success:
                note("failed: %s -> %s" % (text, item.error))

    def reflow(name):
        tree = i3.get_tree()
        workspace = workspace_of(tree, name)
        if workspace is None:
            order.pop(name, None)
            return

        ids = sync_order(name, workspace)
        if not ids:
            order.pop(name, None)
            return
        # A fullscreen window owns the screen; rebuilding underneath it would
        # break true fullscreen.  It is reconciled when fullscreen ends.
        if any(c.fullscreen_mode for c in leaves(workspace)):
            return

        focused = tree.find_focused()
        focused_id = focused.id if focused else None
        note("reflow %s order=%s" % (name, ids))

        for con_id in ids:
            command("[con_id=%d] move container to workspace %s"
                    % (con_id, SCRATCH))

        handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False,
                                             encoding="utf-8")
        json.dump(build_layout(len(ids)), handle)
        handle.close()

        command('[workspace="%s"] focus' % name)
        command('append_layout %s' % handle.name)

        # The placeholders are named; replacing a window's mark with its slot
        # mark keeps the mapping unambiguous.
        slots = []
        for node in i3.get_tree().descendants():
            for mark in node.marks:
                if mark.startswith(SLOT_PREFIX):
                    slots.append((int(mark[len(SLOT_PREFIX):]), node.id))
        slots.sort()

        for index, con_id in enumerate(ids):
            match = [slot for slot in slots if slot[0] == index]
            if not match:
                note("no placeholder for slot %d" % index)
                continue
            command("[con_id=%d] move container to mark %s%d"
                    % (con_id, SLOT_PREFIX, index))

        # Placeholders that are still there are removed so they take no space.
        for _index, con_id in slots:
            command("[con_id=%d] kill" % con_id)

        if focused_id:
            command("[con_id=%d] focus" % focused_id)
        os.unlink(handle.name)

        final = workspace_of(i3.get_tree(), name)
        boxes = []
        for leaf in leaves(final) if final else []:
            boxes.append("%d@%d,%d+%dx%d" % (leaf.id, leaf.rect.x, leaf.rect.y,
                                             leaf.rect.width, leaf.rect.height))
        note("  placed: %s" % " ".join(boxes))

    def handle(i3_conn, event):
        try:
            container = getattr(event, "container", None)
            name = None
            if container is not None:
                workspace = container.workspace()
                if workspace is not None:
                    name = workspace.name
                elif container.type == "workspace":
                    name = container.name
            if not name:
                # A brand-new window is not attached to the tree yet, so its
                # workspace is unknown here; the focused workspace is the one
                # it is about to join.
                focused = i3_conn.get_tree().find_focused()
                workspace = focused.workspace() if focused else None
                name = workspace.name if workspace else None
        except Exception:  # noqa: BLE001 - an event shape we do not use
            return
        if not name or name == SCRATCH:
            return
        if state["busy"]:
            state["pending"].add(name)
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - the helper must not die
            note("error: %s" % error)
        finally:
            state["busy"] = False
        while state["pending"]:
            name = state["pending"].pop()
            state["busy"] = True
            try:
                reflow(name)
            except Exception as error:  # noqa: BLE001
                note("error: %s" % error)
            finally:
                state["busy"] = False

    for event_name in ("window::new", "window::close", "window::move",
                       "window::fullscreen_mode", "window::floating"):
        i3.on(event_name, handle)
    note("started (pid %d)" % os.getpid())
    i3.main()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - keep the failure where it can be read
        import traceback
        note("fatal: " + traceback.format_exc().replace("\n", " | "))
        raise
