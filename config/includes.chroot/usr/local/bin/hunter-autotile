#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately: left takes the 1st, 3rd, 5th... arrival, right the 2nd, 4th, 6th...

Order is arrival order per workspace, tracked by container id - never by title,
and never by whichever window happened to be focused last.

The helper speaks i3's IPC protocol itself: it subscribes to the window events,
asks for the tree, and issues i3's own commands.  Replies and events arrive on
the same socket, so every read demultiplexes them; treating an event as a
command reply is what used to kill the helper after its first command.
"""

import collections
import fcntl
import json
import os
import socket
import struct
import sys
import tempfile
import time

SCRATCH = "smd-autotile-scratch"
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")

RUN_COMMAND = 0
SUBSCRIBE = 2
GET_TREE = 4
EVENT_FLAG = 0x80000000


def note(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        try:
            if os.path.getsize(LOG_PATH) > 65536:
                os.truncate(LOG_PATH, 0)
        except OSError:
            pass
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def find_socket():
    for name in ("I3SOCK", "SWAYSOCK"):
        value = os.environ.get(name)
        if value and os.path.exists(value):
            return value
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    candidates = []
    for base, prefix in ((os.path.join(runtime, "i3"), "ipc-socket."),
                         ("/tmp", "i3-")):
        try:
            for entry in os.listdir(base):
                if entry.startswith(prefix):
                    candidates.append(os.path.join(base, entry))
        except OSError:
            pass
    if candidates:
        candidates.sort(key=lambda p: os.path.getmtime(p))
        return candidates[-1]
    return None


class I3:
    """Minimal i3 IPC client with reply/event demultiplexing."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buffer = b""
        self.pending = collections.deque()

    def _send(self, message_type, payload=""):
        data = payload.encode("utf-8")
        self.sock.sendall(b"i3-ipc" + struct.pack("=II", len(data), message_type) + data)

    def _read_exact(self, count):
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def _read_message(self):
        header = self._read_exact(14)
        if header[:6] != b"i3-ipc":
            raise ValueError("unexpected bytes from i3")
        length, message_type = struct.unpack("=II", header[6:])
        body = self._read_exact(length).decode("utf-8", "replace")
        return message_type, (json.loads(body) if body else None)

    def message(self, message_type, payload=""):
        self._send(message_type, payload)
        while True:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
                continue
            return reply_type, body

    def event(self):
        while not self.pending:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
            else:
                # A reply nobody is waiting for: ignore it, never parse it as
                # an event.
                note("unexpected reply type %d ignored" % reply_type)
        return self.pending.popleft()

    def command(self, text):
        _kind, replies = self.message(RUN_COMMAND, text)
        failed = False
        for reply in replies if isinstance(replies, list) else []:
            if isinstance(reply, dict) and not reply.get("success"):
                note("failed: %s -> %s" % (text, reply.get("error")))
                failed = True
        return not failed

    def tree(self):
        _kind, reply = self.message(GET_TREE)
        return reply if isinstance(reply, dict) else {}


def nodes_of(node, found=None):
    if found is None:
        found = []
    if not isinstance(node, dict):
        return found
    found.append(node)
    for child in node.get("nodes", []) or []:
        nodes_of(child, found)
    return found


def leaves_of(node):
    return [n for n in nodes_of(node)
            if n.get("window") and not n.get("nodes")]


def find_workspace(tree, name):
    for node in nodes_of(tree):
        if node.get("type") == "workspace" and node.get("name") == name:
            return node
    return None


def focused_workspace(tree):
    """The workspace holding the focused window.

    i3 marks "focused" only on the focused container; workspaces keep a focus
    stack instead, so the workspace has to be tracked while descending.
    """

    def walk(node, current):
        for child in node.get("nodes", []) or []:
            inner = child if child.get("type") == "workspace" else current
            if child.get("focused"):
                return inner or child
            hit = walk(child, inner)
            if hit:
                return hit
        return None

    return walk(tree, None)


def workspace_containing(tree, con_id):
    """The workspace whose subtree holds con_id."""

    def walk(node, current):
        for child in node.get("nodes", []) or []:
            inner = child if child.get("type") == "workspace" else current
            if child.get("id") == con_id:
                return inner or child
            hit = walk(child, inner)
            if hit:
                return hit
        return None

    return walk(tree, None)


def main():
    note("starting")

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    path = find_socket()
    if not path:
        note("no i3 IPC socket found")
        return 1
    i3 = I3(path)
    note("connected to %s" % path)

    state = {"order": {}, "busy": False, "pending": set(),
             "last": {}, "last_time": {}}

    def workspace_names():
        return [n.get("name") for n in nodes_of(i3.tree())
                if n.get("type") == "workspace" and n.get("name")
                and n.get("name") != SCRATCH]

    def placeholder(index):
        """One slot of the layout, named so it can be found in the tree.

        i3 layout files have no mark field, so the placeholders are marked
        after they appear, from the tree, in layout order.
        """
        return {"type": "con", "name": "smd-slot", "border": "none",
                # Nothing can match this: the placeholder stays until the
                # helper closes it, so it keeps the slot open.
                "swallows": [{"class": "^$SMD-NEVER-MATCH$"}]}

    def layout_for(count):
        if count <= 2:
            return {"type": "con", "layout": "splith",
                    "nodes": [placeholder(i) for i in range(count)]}
        left = [i for i in range(count) if i % 2 == 0]
        right = [i for i in range(count) if i % 2 == 1]
        return {"type": "con", "layout": "splith", "nodes": [
            {"type": "con", "layout": "splitv", "percent": 0.5,
             "nodes": [placeholder(i) for i in left]},
            {"type": "con", "layout": "splitv", "percent": 0.5,
             "nodes": [placeholder(i) for i in right]},
        ]}

    def clear_slots(name):
        """Close every placeholder on the workspace and wait until none is left."""
        for _attempt in range(10):
            workspace = find_workspace(i3.tree(), name) or {}
            slots = [n["id"] for n in nodes_of(workspace)
                     if n.get("name") == "smd-slot"]
            if not slots:
                return True
            for con_id in slots:
                i3.command("[con_id=%d] kill" % con_id)
            i3.command('[con_mark="^smd-slot-"] kill')
            time.sleep(0.15)
        note("  could not close every placeholder")
        return False

    def build_layout(name, count):
        """Put the column structure on the workspace, one marked slot each."""
        clear_slots(name)
        handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False,
                                             encoding="utf-8")
        json.dump(layout_for(count), handle)
        handle.close()
        i3.command('workspace "%s"' % name)
        i3.command("append_layout %s" % handle.name)
        os.unlink(handle.name)

        # append_layout runs through i3's command queue, so the placeholders
        # can be a moment late: ask for the tree until they are all there.
        slots = []
        for _attempt in range(80):
            workspace = find_workspace(i3.tree(), name) or {}
            slots = [n for n in nodes_of(workspace)
                     if n.get("name") == "smd-slot"]
            if len(slots) >= count:
                break
            time.sleep(0.1)
        slots = slots[:count]
        # What i3 actually built, so a wrong structure is visible in the log.
        shape = []
        for node in nodes_of(find_workspace(i3.tree(), name) or {}):
            if node.get("type") in ("workspace", "con") or node.get("window"):
                rect = node.get("rect") or {}
                shape.append("%s/%s/%s/%dx%d@%d,%d" % (
                    node.get("id"), node.get("type"), node.get("name"),
                    rect.get("width", 0), rect.get("height", 0),
                    rect.get("x", 0), rect.get("y", 0)))
        note("  tree: %s" % " ".join(shape[:14]))
        for index, node in enumerate(slots):
            i3.command('[con_id=%d] mark --add smd-slot-%d'
                       % (node["id"], index))
        note("  placeholders: %d of %d" % (len(slots), count))
        return slots

    def windows_in_tree():
        return {n.get("id") for n in nodes_of(i3.tree()) if n.get("window")}

    def where_is(con_id):
        workspace = workspace_containing(i3.tree(), con_id)
        return workspace.get("name") if workspace else None

    def rescue(name, ids):
        """Never leave a window parked: anything stray comes back."""
        for con_id in ids:
            current = where_is(con_id)
            if current is None:
                continue
            if current != name:
                i3.command("[con_id=%d] move container to workspace %s"
                           % (con_id, name))
                note("  rescued %d from %s" % (con_id, current))

    def reflow(name):
        tree = i3.tree()
        workspace = find_workspace(tree, name)
        live = windows_in_tree()
        # Arrival order lives in this process, not in the tree: parked windows
        # are off the workspace and the tree order is not arrival order.
        order = [i for i in state["order"].get(name, []) if i in live]
        if workspace is not None:
            for node in leaves_of(workspace):
                if node.get("id") not in order and node.get("id") in live:
                    order.append(node.get("id"))
        if not order:
            state["order"].pop(name, None)
            return
        state["order"][name] = order
        if workspace is not None and any(c.get("fullscreen_mode")
                                        for c in leaves_of(workspace)):
            return

        signature = tuple(order)
        last = state["last"].get(name)
        if last == signature and time.time() - state["last_time"].get(name, 0) < 3:
            return
        state["last"][name] = signature
        state["last_time"][name] = time.time()

        note("reflow %s order=%s" % (name, order))

        # Focus first: an emptied workspace that is not focused is reaped, and
        # the layout would then be built on another one.
        i3.command('workspace "%s"' % name)

        if len(order) <= 2:
            # One or two windows need no structure at all: plain moves in
            # arrival order give a full desktop and then two equal halves.
            for con_id in order:
                i3.command("[con_id=%d] move container to workspace %s"
                           % (con_id, name))
        else:
            try:
                # Nothing is parked: i3 destroys an emptied workspace, and the
                # layout would then be built on a different one. The structure
                # is appended beside the windows and every window is then moved
                # into its slot, which never leaves the workspace empty.
                slots = build_layout(name, len(order))
                for index, con_id in enumerate(order):
                    if index < len(slots):
                        # Moving to a slot mark puts the window inside the
                        # slot's parent, which is the column it belongs to.
                        i3.command("[con_id=%d] move container to mark "
                                   "smd-slot-%d" % (con_id, index))
                    else:
                        i3.command("[con_id=%d] move container to workspace %s"
                                   % (con_id, name))
            finally:
                clear_slots(name)

        try:
            final = find_workspace(i3.tree(), name) or {}
            boxes = ["%d@%d,%d+%dx%d" % (c["id"], c["rect"]["x"],
                                         c["rect"]["y"], c["rect"]["width"],
                                         c["rect"]["height"])
                     for c in leaves_of(final)]
            note("  placed: %s" % " ".join(boxes))
            leftover = [n["id"] for n in nodes_of(final)
                        if n.get("name") == "smd-slot"]
            if leftover:
                note("  placeholders still open: %s" % leftover)
        except Exception as error:  # noqa: BLE001 - diagnostics only
            note("  (no geometry report: %s)" % error)

    def wait_for_container(con_id, timeout=2.0):
        """A window::new event arrives before i3 has the window in the tree."""
        if not con_id:
            return False
        deadline = time.time() + timeout
        while True:
            if con_id in windows_in_tree():
                return True
            if time.time() >= deadline:
                return False
            time.sleep(0.1)

    def handle(name):
        if not name or name == SCRATCH:
            return
        if state["busy"]:
            state["pending"].add(name)
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - the helper must not die
            note("error: %s" % error)
        finally:
            state["busy"] = False
        while state["pending"]:
            queued = state["pending"].pop()
            state["busy"] = True
            try:
                reflow(queued)
            except Exception as error:  # noqa: BLE001
                note("error: %s" % error)
            finally:
                state["busy"] = False

    # The helper never changes workspace: parking happens with "move
    # container to workspace", which does not take the focus away from the
    # workspace the owner is working in.
    i3.message(SUBSCRIBE, json.dumps(["window"]))
    note("subscribed to window events")

    for name in workspace_names():
        handle(name)

    while True:
        try:
            payload = i3.event()
        except (ConnectionError, ValueError) as error:
            note("connection lost (%s), reconnecting" % error)
            time.sleep(2)
            path = find_socket()
            if not path:
                return 1
            i3 = I3(path)
            i3.message(SUBSCRIBE, json.dumps(["window"]))
            for name in workspace_names():
                handle(name)
            continue
        if not isinstance(payload, dict):
            continue
        container = payload.get("container") or {}
        marks = [str(m) for m in container.get("marks", []) or []]
        if container.get("name") == "smd-slot" or any(
                m.startswith("smd-slot") for m in marks):
            # Killing the placeholders raises events of their own.
            continue
        change = payload.get("change")
        if change in ("new", "close", "fullscreen_mode"):
            # A closing window is already gone from the tree and a new one may
            # not be in it yet, so its workspace is looked up first and the
            # focused workspace is the fallback.
            con_id = (payload.get("container") or {}).get("id")
            if change == "new" and not wait_for_container(con_id):
                note("event new: container %s never appeared" % con_id)
            tree = i3.tree()
            workspace = (workspace_containing(tree, con_id) if con_id else None) \
                or focused_workspace(tree)
            name = workspace.get("name") if workspace else None
            note("event %s on workspace %s" % (change, name))
            handle(name)
        # A move is never a rebuild reason: the helper parks and restores
        # windows itself, so reacting to its own moves would loop.
        elif change == "empty":
            name = (payload.get("container") or {}).get("name")
            state["order"].pop(name, None)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - keep the failure where it can be read
        import traceback
        note("fatal: " + traceback.format_exc().replace("\n", " | "))
        raise
