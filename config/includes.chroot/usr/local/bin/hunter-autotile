#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately.

Order is arrival order per workspace, tracked by container id - never by title,
and never by whichever window happened to be focused last, which is what a
generic "split the active window" script gets wrong.

Placement uses i3's marks: "move container to mark X" inserts the moved window
directly after the marked one inside the same parent, so the structure is built
deterministically instead of depending on where focus happens to be.  Windows
are parked on a scratch workspace first, so nesting from an earlier layout
cannot leak into the new one.
"""

import fcntl
import json
import os
import sys
import time

SCRATCH = "smd-autotile-scratch"
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")


def note(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        if os.path.getsize(LOG_PATH) > 65536:
            os.truncate(LOG_PATH, 0)
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def main():
    try:
        import i3ipc
    except ImportError:
        note("python3-i3ipc is missing")
        return 1

    # One helper per session: an i3 restart re-runs exec_always.
    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    i3 = i3ipc.Connection()
    order = {}
    state = {"busy": False, "pending": set()}

    def leaves(workspace):
        found = []

        def walk(node):
            for child in node.nodes or []:
                if child.type == "con" and child.window and not child.floating:
                    found.append(child)
                elif child.type in ("con", "workspace", "output", "root"):
                    walk(child)

        walk(workspace)
        return found

    def workspace_of(tree, name):
        for workspace in tree.workspaces():
            if workspace.name == name:
                return workspace
        return None

    def sync_order(name, workspace):
        current = [c.id for c in leaves(workspace)] if workspace else []
        known = [i for i in order.get(name, []) if i in current]
        for con_id in current:
            if con_id not in known:
                known.append(con_id)
        order[name] = known
        return known

    def reflow(name):
        tree = i3.get_tree()
        workspace = workspace_of(tree, name)
        if workspace is None:
            order.pop(name, None)
            return

        ids = sync_order(name, workspace)
        if not ids:
            order.pop(name, None)
            return
        # A fullscreen window owns the screen; rebuilding underneath it would
        # break true fullscreen.  It is reconciled when fullscreen ends.
        if any(c.fullscreen_mode for c in leaves(workspace)):
            return

        focused = tree.find_focused()
        focused_id = focused.id if focused else None
        note("reflow %s order=%s" % (name, ids))

        def run(command):
            reply = i3.command(command)
            for item in reply:
                if not item.success:
                    note("failed: %s -> %s" % (command, item.error))

        mark = lambda con_id: "smd-%d" % con_id

        for con_id in ids:
            run("[con_id=%d] move container to workspace %s" % (con_id, SCRATCH))

        for index, con_id in enumerate(ids):
            if index == 0:
                run("[con_id=%d] move container to workspace %s" % (con_id, name))
            elif index == 1:
                run("[con_id=%d] split h" % ids[0])
                run("[con_id=%d] move container to mark %s" % (con_id, mark(ids[0])))
            elif index == 2:
                run("[con_id=%d] split v" % ids[0])
                run("[con_id=%d] move container to mark %s" % (con_id, mark(ids[0])))
            elif index == 3:
                run("[con_id=%d] split v" % ids[1])
                run("[con_id=%d] move container to mark %s" % (con_id, mark(ids[1])))
            else:
                # Continue the columns: left takes even indexes, right odd.
                column = ids[index % 2::2]
                previous = [i for i in column if i != con_id]
                target = previous[-1] if previous else ids[index % 2]
                run("[con_id=%d] move container to mark %s"
                    % (con_id, mark(target)))
            run("[con_id=%d] mark --add %s" % (con_id, mark(con_id)))

        if focused_id:
            run("[con_id=%d] focus" % focused_id)

    def handle(i3_conn, event):
        try:
            container = getattr(event, "container", None)
            if container is None:
                return
            workspace = container.workspace()
            name = workspace.name if workspace else None
        except Exception:  # noqa: BLE001 - an event shape we do not use
            return
        if not name or name == SCRATCH:
            return
        if state["busy"]:
            state["pending"].add(name)
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - the helper must not die
            note("error: %s" % error)
        finally:
            state["busy"] = False
        while state["pending"]:
            name = state["pending"].pop()
            state["busy"] = True
            try:
                reflow(name)
            except Exception as error:  # noqa: BLE001
                note("error: %s" % error)
            finally:
                state["busy"] = False

    for event_name in ("window::new", "window::close", "window::move",
                       "window::fullscreen_mode", "window::floating"):
        i3.on(event_name, handle)
    note("started (pid %d)" % os.getpid())
    i3.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
