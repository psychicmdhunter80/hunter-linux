#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately: left takes the 1st, 3rd, 5th... arrival, right the 2nd, 4th, 6th...

Order is arrival order per workspace, tracked by container id - never by title,
and never by whichever window happened to be focused last.

The helper speaks i3's IPC protocol itself: it subscribes to the window and
workspace events, asks for the tree, and issues i3's own commands.  Replies and
events arrive on the same socket, so every read demultiplexes them; treating an
event as a command reply is what used to kill the helper after its first
command.

A window that moves to another workspace changes the shape of both ends: the
one it left has a tile fewer, the one it arrived on a tile more, so both are
rebuilt.  The layout is made by splitting the window that has to share its half
and moving the new one beside it, so nothing is appended to the workspace and
no structure is left behind for a later rebuild to nest inside.  Nothing here
switches the workspace, so a workspace the owner is not looking at is marked
due and arranged the moment it is shown: the layout goes into the tree, never
into the view, and never pulls the focus away from what he is working on.
"""

import collections
import fcntl
import json
import os
import socket
import struct
import sys
import time

SCRATCH = "smd-autotile-scratch"

# Windows that must never be rearranged: the installer and its dialogs, error
# boxes and password prompts are transitory and a moving target breaks them.
DENIED_CLASSES = {"calamares", "yad", "zenity", "xmessage", "gcr-prompter",
                  "polkit-gnome-authentication-agent-1", "lxpolkit"}
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")

RUN_COMMAND = 0
SUBSCRIBE = 2
GET_TREE = 4
EVENT_FLAG = 0x80000000


def note(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        try:
            if os.path.getsize(LOG_PATH) > 65536:
                os.truncate(LOG_PATH, 0)
        except OSError:
            pass
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def find_socket():
    for name in ("I3SOCK", "SWAYSOCK"):
        value = os.environ.get(name)
        if value and os.path.exists(value):
            return value
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    candidates = []
    for base, prefix in ((os.path.join(runtime, "i3"), "ipc-socket."),
                         ("/tmp", "i3-")):
        try:
            for entry in os.listdir(base):
                if entry.startswith(prefix):
                    candidates.append(os.path.join(base, entry))
        except OSError:
            pass
    if candidates:
        candidates.sort(key=lambda p: os.path.getmtime(p))
        return candidates[-1]
    return None


class I3:
    """Minimal i3 IPC client with reply/event demultiplexing."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buffer = b""
        self.pending = collections.deque()

    def _send(self, message_type, payload=""):
        data = payload.encode("utf-8")
        self.sock.sendall(b"i3-ipc" + struct.pack("=II", len(data), message_type) + data)

    def _read_exact(self, count):
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def _read_message(self):
        header = self._read_exact(14)
        if header[:6] != b"i3-ipc":
            raise ValueError("unexpected bytes from i3")
        length, message_type = struct.unpack("=II", header[6:])
        body = self._read_exact(length).decode("utf-8", "replace")
        return message_type, (json.loads(body) if body else None)

    def message(self, message_type, payload=""):
        self._send(message_type, payload)
        while True:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
                continue
            return reply_type, body

    def event(self):
        while not self.pending:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
            else:
                # A reply nobody is waiting for: ignore it, never parse it as
                # an event.
                note("unexpected reply type %d ignored" % reply_type)
        return self.pending.popleft()

    def command(self, text):
        _kind, replies = self.message(RUN_COMMAND, text)
        failed = False
        for reply in replies if isinstance(replies, list) else []:
            if isinstance(reply, dict) and not reply.get("success"):
                note("failed: %s -> %s" % (text, reply.get("error")))
                failed = True
        return not failed

    def tree(self):
        _kind, reply = self.message(GET_TREE)
        return reply if isinstance(reply, dict) else {}


def nodes_of(node, found=None):
    if found is None:
        found = []
    if not isinstance(node, dict):
        return found
    found.append(node)
    for child in node.get("nodes", []) or []:
        nodes_of(child, found)
    return found


def leaves_of(node):
    return [n for n in nodes_of(node)
            if n.get("window") and not n.get("nodes")]


def denied(node):
    """True for the installer and dialogs: they must never be rearranged."""
    properties = node.get("window_properties") or {}
    title = str(properties.get("title") or node.get("name") or "")
    return (str(properties.get("class", "")).lower() in DENIED_CLASSES
            or title.lower().startswith(("install smd linux", "calamares")))


def find_workspace(tree, name):
    for node in nodes_of(tree):
        if node.get("type") == "workspace" and node.get("name") == name:
            return node
    return None


def focused_workspace(tree):
    """The workspace holding the focused window.

    i3 marks "focused" only on the focused container; workspaces keep a focus
    stack instead, so the workspace has to be tracked while descending.
    """

    def walk(node, current):
        for child in node.get("nodes", []) or []:
            inner = child if child.get("type") == "workspace" else current
            if child.get("focused"):
                return inner or child
            hit = walk(child, inner)
            if hit:
                return hit
        return None

    return walk(tree, None)


def workspace_containing(tree, con_id):
    """The workspace whose subtree holds con_id."""

    def walk(node, current):
        for child in node.get("nodes", []) or []:
            inner = child if child.get("type") == "workspace" else current
            if child.get("id") == con_id:
                return inner or child
            hit = walk(child, inner)
            if hit:
                return hit
        return None

    return walk(tree, None)


def main():
    note("starting")

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    path = find_socket()
    if not path:
        note("no i3 IPC socket found")
        return 1
    i3 = I3(path)
    note("connected to %s" % path)

    state = {"order": {}, "busy": False, "pending": set(),
             "settled": {}, "where": {}, "due": set()}

    def workspace_names():
        return [n.get("name") for n in nodes_of(i3.tree())
                if n.get("type") == "workspace" and n.get("name")
                and n.get("name") != SCRATCH]


    def windows_in_tree():
        return {n.get("id") for n in nodes_of(i3.tree()) if n.get("window")}

    def where_is(con_id):
        workspace = workspace_containing(i3.tree(), con_id)
        return workspace.get("name") if workspace else None

    def rescue(name, ids):
        """Never leave a window parked: anything stray comes back."""
        for con_id in ids:
            current = where_is(con_id)
            if current is None:
                continue
            if current != name:
                i3.command("[con_id=%d] move container to workspace %s"
                           % (con_id, name))
                note("  rescued %d from %s" % (con_id, current))

    def expected_layout(order_ids, geometry):
        """Do the rectangles match the layout this many windows should have?"""
        boxes = [geometry[i] for i in order_ids]
        if len(boxes) == 1:
            return True
        if len(boxes) == 2:
            (ax, ay, aw, ah) = boxes[0]
            (bx, by, bw, bh) = boxes[1]
            return abs(aw - bw) <= 6 and abs(ay - by) <= 6 and ax != bx
        if len(boxes) == 3:
            (ax, ay, aw, ah) = boxes[0]
            (bx, by, bw, bh) = boxes[1]
            (cx, cy, cw, ch) = boxes[2]
            return (abs(cx - ax) <= 6 and cy > ay and abs(cw - aw) <= 6
                    and bx > ax and abs(bw - aw) <= 6)
        if len(boxes) == 4:
            (ax, ay, aw, ah) = boxes[0]
            (bx, by, bw, bh) = boxes[1]
            (cx, cy, cw, ch) = boxes[2]
            (dx, dy, dw, dh) = boxes[3]
            return (abs(cx - ax) <= 6 and abs(dx - bx) <= 6 and cy > ay
                    and dy > by and abs(aw - bw) <= 6 and abs(cw - dw) <= 6)
        return True

    def geometry_of(name):
        workspace = find_workspace(i3.tree(), name) or {}
        return {c["id"]: (c["rect"]["x"], c["rect"]["y"],
                          c["rect"]["width"], c["rect"]["height"])
                for c in leaves_of(workspace)}

    def reflow(name, attempt=1):
        tree = i3.tree()
        workspace = find_workspace(tree, name)
        # Arrival order lives in this process, not in the tree: the tree order
        # is not arrival order once windows have been moved around.  It is only
        # used for the windows that are still here, though: a window moved to
        # another workspace used to be pulled back to this one on the next
        # rebuild, because it was still in this workspace's remembered order.
        here = {node.get("id") for node in leaves_of(workspace or {})}
        order = [i for i in state["order"].get(name, []) if i in here]
        if workspace is not None:
            for node in leaves_of(workspace):
                con_id = node.get("id")
                if con_id not in order:
                    order.append(con_id)
        if not order:
            state["order"].pop(name, None)
            state["settled"].pop(name, None)
            return
        state["order"][name] = order
        for con_id in order:
            state["where"][con_id] = name

        if workspace is not None and any(c.get("fullscreen_mode")
                                        for c in leaves_of(workspace)):
            # A fullscreen window owns the screen; its workspace is left alone
            # until it comes back, and then the set is rebuilt once.
            state["settled"].pop(name, None)
            return
        if any(denied(c) for c in leaves_of(workspace or {})):
            note("leaving %s alone: it holds an installer or dialog window" % name)
            return

        # A workspace is rebuilt only when the set of windows on it changes.
        # The helper's own commands raise window events of their own, and a
        # timer cannot separate those from a real window arriving on a slow
        # machine: the window set can.
        signature = tuple(order)
        if attempt == 1 and state["settled"].get(name) == signature:
            state["due"].discard(name)
            return

        # Rebuilding a workspace the owner is not looking at would take the
        # focus away from what he is working on, so it is marked due and
        # rebuilt the moment it is shown - which is also the first moment its
        # arrangement can be seen at all.
        current = focused_workspace(i3.tree()) or {}
        if current.get("name") != name:
            state["due"].add(name)
            note("%s is not on screen: it is arranged when it is shown" % name)
            return
        state["due"].discard(name)

        note("reflow %s order=%s attempt=%d" % (name, order, attempt))

        # Nothing switches the workspace here.  The arrangement is made with
        # commands that name the windows they act on, so it does not need the
        # view - and asking i3 for the workspace that already has the focus is
        # not a no-op: with workspace_auto_back_and_forth, which the shipped
        # config sets, it sends the owner to the workspace he came from every
        # time anything is arranged.

        if len(order) > 1:
            # Start from a flat workspace.  A window left inside the half an
            # older rebuild made for it would be split again, one wrapper
            # deeper on every rebuild, until the windows sat in a stack of
            # containers instead of a row.  Each window but the first is taken
            # out to a workspace of the helper's own and put straight back:
            # i3 destroys the container it left behind, the workspace is never
            # empty, and arrival order is kept because they go back in it.
            for con_id in order[1:]:
                i3.command("[con_id=%d] move --no-auto-back-and-forth "
                           "container to workspace %s" % (con_id, SCRATCH))
                i3.command("[con_id=%d] move --no-auto-back-and-forth "
                           "container to workspace %s" % (con_id, name))
            # The row is what two windows are, and the base of every other
            # shape.  "layout splith" applies to the focused window's parent,
            # so something at the top of the workspace has the focus first.
            i3.command("[con_id=%d] focus" % order[-1])
            i3.command("layout splith")

        if len(order) == 1:
            # One window fills the workspace on its own, so it only has to be
            # brought back when it is on another one.  Moving it to the
            # workspace it is already on is not a no-op - with
            # workspace_auto_back_and_forth i3 reads it as "go back" and sends
            # the window to the workspace the owner came from - so it is never
            # done blindly, and the flag is passed when it is done at all.
            if where_is(order[0]) != name:
                i3.command("[con_id=%d] move --no-auto-back-and-forth "
                           "container to workspace %s" % (order[0], name))
        else:
            # The columns are made from the windows themselves: i3 splits a
            # workspace when a window arrives, so the only thing left to do is
            # to make the half that has to hold two of them vertical, around
            # the one that stays on top.  Nothing is appended, so there is no
            # wrapper container to be left behind and nested into by the next
            # rebuild - which is what turned two windows into two thirds of the
            # screen and three into three narrow tiles in one half.
            parents = {child.get("id"): node
                       for node in nodes_of(i3.tree())
                       for child in (node.get("nodes") or [])}
            for index in range(2, len(order)):
                top = order[index - 2]
                mark = "smd-pair-%d" % index
                holder = parents.get(top) or {}
                # The half this window belongs in may already be there, left
                # behind as a vertical container holding it alone when the
                # other window of the pair moved away.  Splitting it again
                # would bury the pair one wrapper deeper on every rebuild.
                half = (holder.get("layout") == "splitv"
                        and not holder.get("window")
                        and len(holder.get("nodes") or []) == 1)
                i3.command("[con_id=%d] mark --add %s" % (top, mark))
                if half:
                    note("  reusing the empty half above %d" % top)
                else:
                    i3.command("[con_id=%d] focus" % top)
                    i3.command("split vertical")
                i3.command("[con_id=%d] move container to mark %s"
                           % (order[index], mark))
                i3.command("unmark %s" % mark)
                time.sleep(0.15)

        geometry = geometry_of(name)
        placed = [con_id for con_id in order if con_id in geometry]
        good = len(placed) == len(order) and expected_layout(order, geometry)
        note("  placed: %s" % " ".join(
            "%d@%d,%d+%dx%d" % ((con_id,) + geometry[con_id])
            for con_id in placed))
        if good:
            state["settled"][name] = signature
            return
        if attempt < 2:
            # i3 applies commands through a queue: one retry is allowed, and
            # only when the result really is wrong.
            note("  layout not as expected, retrying once")
            time.sleep(0.4)
            reflow(name, attempt + 1)
        else:
            note("  layout still not as expected")
            state["settled"][name] = signature

    def wait_for_container(con_id, timeout=2.0):
        """A window::new event arrives before i3 has the window in the tree."""
        if not con_id:
            return False
        deadline = time.time() + timeout
        while True:
            if con_id in windows_in_tree():
                return True
            if time.time() >= deadline:
                return False
            time.sleep(0.1)

    def handle(name):
        if not name or name == SCRATCH:
            return
        if state["busy"]:
            state["pending"].add(name)
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - the helper must not die
            note("error: %s" % error)
        finally:
            state["busy"] = False
        while state["pending"]:
            queued = state["pending"].pop()
            state["busy"] = True
            try:
                reflow(queued)
            except Exception as error:  # noqa: BLE001
                note("error: %s" % error)
            finally:
                state["busy"] = False

    # The helper never takes the focus away from the workspace the owner is
    # working in: parking happens with "move container to workspace", and a
    # workspace that needs rebuilding is arranged when it is shown.
    i3.message(SUBSCRIBE, json.dumps(["window", "workspace"]))
    note("subscribed to window and workspace events")

    for name in workspace_names():
        handle(name)

    def handle_event(payload):
        """One window event: recognise the helper's own and rebuild if needed."""
        container = payload.get("container") or {}
        change = payload.get("change")
        if change in ("focus", "init") and isinstance(payload.get("current"), dict):
            # A workspace has just been shown: anything left due on it is
            # arranged now, while it has the focus the rebuild needs.
            name = payload["current"].get("name")
            if name and name != SCRATCH:
                note("event %s on workspace %s" % (change, name))
                handle(name)
            return
        if change in ("new", "close", "fullscreen_mode", "floating"):
            # A closing window is already gone from the tree and a new one may
            # not be in it yet, so its workspace is looked up first, then the
            # one it was last seen on, and the focused workspace last.
            con_id = (payload.get("container") or {}).get("id")
            if change == "new" and not wait_for_container(con_id):
                note("event new: container %s never appeared" % con_id)
            tree = i3.tree()
            workspace = (workspace_containing(tree, con_id) if con_id else None) \
                or ({"name": state["where"][con_id]}
                    if state["where"].get(con_id) else None) \
                or focused_workspace(tree)
            name = workspace.get("name") if workspace else None
            note("event %s on workspace %s" % (change, name))
            handle(name)
        elif change == "move":
            # Both ends changed shape.  The helper's own moves arrive here as
            # well, and they change nothing: the workspace they happen on is
            # already settled for exactly that set of windows.
            con_id = container.get("id")
            here = (workspace_containing(i3.tree(), con_id) or {}).get("name")
            was = state["where"].get(con_id)
            if not here or here == SCRATCH:
                return
            state["where"][con_id] = here
            if was == here:
                return
            note("window %s moved from %s to %s" % (con_id, was, here))
            for name in (here, was):
                if name and name != SCRATCH:
                    state["due"].add(name)
                    handle(name)
        elif change == "empty":
            name = (payload.get("container") or {}).get("name")
            state["order"].pop(name, None)
            state["settled"].pop(name, None)
            state["due"].discard(name)

    while True:
        try:
            payload = i3.event()
        except (ConnectionError, ValueError) as error:
            note("connection lost (%s), reconnecting" % error)
            time.sleep(2)
            path = find_socket()
            if not path:
                return 1
            i3 = I3(path)
            i3.message(SUBSCRIBE, json.dumps(["window", "workspace"]))
            for name in workspace_names():
                handle(name)
            continue
        if not isinstance(payload, dict):
            continue
        # No single event may end the helper: the rest of the session would then
        # lose its layout silently.
        try:
            handle_event(payload)
        except Exception as error:  # noqa: BLE001
            note("event error: %s" % error)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - keep the failure where it can be read
        import traceback
        note("fatal: " + traceback.format_exc().replace("\n", " | "))
        raise
