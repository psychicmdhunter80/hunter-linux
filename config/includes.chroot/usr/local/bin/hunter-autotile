#!/usr/bin/env python3
"""Keep ordinary windows in the balanced layout the owner asked for.

One window fills the usable desktop; two are equal halves; the third goes
below the first on the left, the fourth below the second on the right, so four
windows form an even 2x2 grid.  Beyond four the columns keep growing
alternately.

The order is arrival order per workspace, tracked by container id - never by
title or by what happened to be focused last, which is what a generic
"split on active window" script gets wrong.  Everything is driven by i3's IPC
events and native split/move commands; there is no polling.
"""

import fcntl
import os
import sys
import time

SCRATCH = "smd-autotile-scratch"


def main():
    try:
        import i3ipc
    except ImportError:
        sys.stderr.write("hunter-autotile: python3-i3ipc is missing\n")
        return 1

    # One instance per session: an i3 restart re-runs exec_always.
    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0

    i3 = i3ipc.Connection()
    order = {}          # workspace name -> [container id, ...] in arrival order
    pending = {}        # workspace name -> the id that arrived while busy
    state = {"busy": False}

    def leaves(workspace):
        found = []

        def walk(node):
            for child in node.nodes or []:
                if child.type == "con" and child.window and not child.floating:
                    found.append(child)
                elif child.type in ("con", "workspace"):
                    walk(child)

        walk(workspace)
        return found

    def workspace_of(tree, name):
        for workspace in tree.workspaces():
            if workspace.name == name:
                return workspace
        return None

    def sync_order(name, workspace):
        current = [c.id for c in leaves(workspace)] if workspace else []
        known = [i for i in order.get(name, []) if i in current]
        for con_id in current:
            if con_id not in known:
                known.append(con_id)
        order[name] = known
        return known

    def reflow(name):
        """Rebuild one workspace in arrival order."""
        tree = i3.get_tree()
        workspace = workspace_of(tree, name)
        if workspace is None:
            order.pop(name, None)
            return

        ids = sync_order(name, workspace)
        if not ids:
            order.pop(name, None)
            return
        # A fullscreen window owns the whole screen; rebuilding underneath it
        # would fight it and break true fullscreen.  It is reconciled when the
        # user leaves fullscreen.
        if any(c.fullscreen_mode for c in leaves(workspace)):
            return

        focused = tree.find_focused()
        focused_id = focused.id if focused else None

        def run(command):
            i3.command(command)

        # Park everything first so nesting from previous layouts cannot leak in.
        for con_id in ids:
            run("[con_id=%d] move container to workspace %s" % (con_id, SCRATCH))

        for index, con_id in enumerate(ids):
            if index == 0:
                run("[con_id=%d] move container to workspace %s" % (con_id, name))
                if len(ids) == 1:
                    continue
                run("[con_id=%d] focus; split h" % con_id)
            elif index == 1:
                run("[con_id=%d] move container to workspace %s" % (con_id, name))
            elif index == 2:
                run("[con_id=%d] focus; split v" % ids[0])
                run("[con_id=%d] move container to workspace %s" % (con_id, name))
            elif index == 3:
                run("[con_id=%d] focus; split v" % ids[1])
                run("[con_id=%d] move container to workspace %s" % (con_id, name))
            else:
                # Alternate the columns: left gets even indexes, right odd.
                column = ids[index % 2 :: 2]
                previous = [i for i in column if i != con_id]
                target = previous[-1] if previous else ids[index % 2]
                run("[con_id=%d] focus" % target)
                run("[con_id=%d] move container to workspace %s" % (con_id, name))

        if focused_id:
            run("[con_id=%d] focus" % focused_id)

    def handle(i3_conn, event):
        name = None
        if hasattr(event, "container") and event.container:
            workspace = event.container.workspace()
            name = workspace.name if workspace else None
        if name is None or name == SCRATCH:
            return
        if state["busy"]:
            pending[name] = True
            return
        state["busy"] = True
        try:
            reflow(name)
        except Exception as error:  # noqa: BLE001 - a helper must not die
            sys.stderr.write("hunter-autotile: %s\n" % error)
        finally:
            state["busy"] = False
        while pending:
            name, _ = pending.popitem()
            state["busy"] = True
            try:
                reflow(name)
            except Exception as error:  # noqa: BLE001
                sys.stderr.write("hunter-autotile: %s\n" % error)
            finally:
                state["busy"] = False

    for event_name in ("window::new", "window::close", "window::move",
                       "window::fullscreen_mode", "window::floating"):
        i3.on(event_name, handle)
    i3.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
