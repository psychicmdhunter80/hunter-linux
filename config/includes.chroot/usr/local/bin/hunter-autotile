#!/usr/bin/env python3
"""Keep at most two ordinary windows on each of ten workspaces.

The rule the owner approved for 1.7.0:

  * the first ordinary window on a workspace fills it;
  * the second splits it into equal left and right halves, in arrival order,
    so the first window stays on the left;
  * a third window is not squeezed in.  It goes, as the first window, to the
    next empty workspace in numerical order - wrapping through 1..10 - and
    that workspace is shown, so the program that was just opened is visible
    where it is.

A window the owner moves by hand into a workspace that already holds two is
kept there as a floating window and he is told why; when all ten workspaces
already hold a window and the current one is full, a newly opened program is
kept floating on the workspace it opened on and he is told that no empty
workspace is left.  Nothing is ever closed to make room, no other window is
moved to make room, no eleventh workspace is created, and an existing
arrangement is never rebuilt: i3 splits a workspace when the second window
arrives and collapses the split when one leaves, which is already the
one-then-two layout, so this helper only acts when a window would make a
third.

That is also why the helper never touches the workspace that is not on
screen: opening a window on the workspace the owner is looking at can move
that one window, and anything else i3 settles itself without the focus being
taken away from him.  It issues i3's own commands by container id, so nothing
here depends on which workspace happens to have the focus, and none of its
commands produces another one of its own events that it would act on.
"""

import collections
import fcntl
import json
import os
import socket
import struct
import subprocess
import sys
import time

MAX_WORKSPACES = 10
MAX_TILED = 2

# Windows that must never be rearranged: the installer and its dialogs, error
# boxes and password prompts are transitory and a moving target breaks them.
# They are floating windows on this image, so they are not counted either.
DENIED_CLASSES = {"calamares", "yad", "zenity", "xmessage", "gcr-prompter",
                  "polkit-gnome-authentication-agent-1", "lxpolkit"}
LOG_PATH = os.path.expanduser("~/.cache/smd/autotile.log")

RUN_COMMAND = 0
SUBSCRIBE = 2
GET_TREE = 4
EVENT_FLAG = 0x80000000


def note(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        try:
            if os.path.getsize(LOG_PATH) > 65536:
                os.truncate(LOG_PATH, 0)
        except OSError:
            pass
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), message))
    except OSError:
        pass


def find_socket():
    for name in ("I3SOCK", "SWAYSOCK"):
        value = os.environ.get(name)
        if value and os.path.exists(value):
            return value
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    candidates = []
    for base, prefix in ((os.path.join(runtime, "i3"), "ipc-socket."),
                         ("/tmp", "i3-")):
        try:
            for entry in os.listdir(base):
                if entry.startswith(prefix):
                    candidates.append(os.path.join(base, entry))
        except OSError:
            pass
    if candidates:
        candidates.sort(key=lambda p: os.path.getmtime(p))
        return candidates[-1]
    return None


class I3:
    """Minimal i3 IPC client with reply/event demultiplexing."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buffer = b""
        self.pending = collections.deque()

    def _send(self, message_type, payload=""):
        data = payload.encode("utf-8")
        self.sock.sendall(b"i3-ipc" + struct.pack("=II", len(data), message_type) + data)

    def _read_exact(self, count):
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def _read_message(self):
        header = self._read_exact(14)
        if header[:6] != b"i3-ipc":
            raise ValueError("unexpected bytes from i3")
        length, message_type = struct.unpack("=II", header[6:])
        body = self._read_exact(length).decode("utf-8", "replace")
        return message_type, (json.loads(body) if body else None)

    def message(self, message_type, payload=""):
        self._send(message_type, payload)
        while True:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
                continue
            return reply_type, body

    def event(self):
        while not self.pending:
            reply_type, body = self._read_message()
            if reply_type & EVENT_FLAG:
                self.pending.append(body)
            else:
                # A reply nobody is waiting for: ignore it, never parse it as
                # an event.
                note("unexpected reply type %d ignored" % reply_type)
        return self.pending.popleft()

    def command(self, text):
        _kind, replies = self.message(RUN_COMMAND, text)
        failed = False
        for reply in replies if isinstance(replies, list) else []:
            if isinstance(reply, dict) and not reply.get("success"):
                note("failed: %s -> %s" % (text, reply.get("error")))
                failed = True
        return not failed

    def tree(self):
        _kind, reply = self.message(GET_TREE)
        return reply if isinstance(reply, dict) else {}


def nodes_of(node, found=None):
    if found is None:
        found = []
    if not isinstance(node, dict):
        return found
    found.append(node)
    for child in node.get("nodes", []) or []:
        nodes_of(child, found)
    return found


def leaves_of(node):
    return [n for n in nodes_of(node)
            if n.get("window") and not n.get("nodes")]


def denied(node):
    """True for the installer and dialogs: they must never be rearranged."""
    properties = node.get("window_properties") or {}
    title = str(properties.get("title") or node.get("name") or "")
    return (str(properties.get("class", "")).lower() in DENIED_CLASSES
            or title.lower().startswith(("install smd linux", "calamares")))


def floating(node):
    return str(node.get("floating", "")).endswith("_on")


def workspace_holding(tree, con_id):
    """The workspace whose subtree holds con_id, floating windows included."""

    def walk(node, current):
        for key in ("nodes", "floating_nodes"):
            for child in node.get(key, []) or []:
                inner = child if child.get("type") == "workspace" else current
                if child.get("id") == con_id:
                    return inner or child
                hit = walk(child, inner)
                if hit:
                    return hit
        return None

    return walk(tree, None)


def find_node(tree, con_id):
    for node in nodes_of(tree):
        if node.get("id") == con_id:
            return node
    return None


def workspace_number(workspace):
    number = (workspace or {}).get("num")
    if isinstance(number, int) and 1 <= number <= MAX_WORKSPACES:
        return number
    return None


def tiled_windows(workspace):
    """The ordinary tiled windows on a workspace, floating ones left out."""
    return [node for node in leaves_of({"nodes": (workspace or {}).get("nodes") or []})
            if not denied(node)]


def window_title(node):
    properties = node.get("window_properties") or {}
    title = str(properties.get("title") or node.get("name") or "the window")
    return " ".join(title.split())[:60]


def next_empty_workspace(tree, current):
    """The next workspace in numerical order with no tiled window on it."""
    held = {}
    for node in nodes_of(tree):
        if node.get("type") == "workspace":
            number = workspace_number(node)
            if number is not None:
                held[number] = len(tiled_windows(node))
    for step in range(1, MAX_WORKSPACES):
        number = ((current - 1 + step) % MAX_WORKSPACES) + 1
        if held.get(number, 0) == 0:
            return number
    return None


def notify(title, body):
    """Tell the owner in the session he is looking at."""
    note("notify: %s - %s" % (title, body))
    for command in (["notify-send", "-a", "SMD Linux", "-i", "smd-menu",
                     "-t", "12000", title, body],
                    ["i3-nagbar", "-m", "%s: %s" % (title, body)]):
        try:
            subprocess.run(command, timeout=8, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except (OSError, subprocess.SubprocessError):
            continue


def main():
    note("starting")

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "hunter-autotile.lock")
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        note("another instance already holds the lock")
        return 0

    path = find_socket()
    if not path:
        note("no i3 IPC socket found")
        return 1
    i3 = I3(path)
    note("connected to %s" % path)

    # The window this helper moved itself.  Its own move raises a move event
    # of its own; recognising it is what keeps the helper from acting on its
    # own work and from moving the same window twice.
    own = set()

    def wait_for_container(con_id, timeout=3.0):
        """A window::new event arrives before i3 has the window in the tree."""
        deadline = time.time() + timeout
        while time.time() < deadline:
            if find_node(i3.tree(), con_id):
                return True
            time.sleep(0.1)
        return False

    def float_overflow(con_id, number, title, why):
        """Keep the window, floating and visible, and say so.

        Each command carries the criteria on its own.  i3 applies a criteria
        prefix to one command, so a chained "floating enable, resize set ..."
        resizes whatever happens to be focused - a tiled window on this image,
        which turned a pair of halves into a 66/33 split.  Naming the window in
        every command is what keeps the exception to the window that needs it.
        """
        i3.command("[con_id=%d] mark --add smd-overflow" % con_id)
        i3.command("[con_id=%d] floating enable" % con_id)
        i3.command("[con_id=%d] resize set 66 ppt 70 ppt" % con_id)
        i3.command("[con_id=%d] move position center" % con_id)
        notify("Workspace %d is full" % number,
               "%s is floating there. %s" % (title, why))

    def handle(payload):
        change = payload.get("change")
        if change not in ("new", "move", "floating"):
            return
        container = payload.get("container") or {}
        con_id = container.get("id")
        if not con_id:
            return
        if change == "new" and not wait_for_container(con_id):
            note("event new: container %s never appeared" % con_id)
            return
        if change == "move":
            if con_id in own:
                # The move this helper just made, already accounted for.
                own.discard(con_id)
                return
        tree = i3.tree()
        node = find_node(tree, con_id)
        if node is None or floating(node) or denied(node):
            return
        workspace = workspace_holding(tree, con_id)
        number = workspace_number(workspace)
        if number is None:
            return
        held = tiled_windows(workspace)
        if len(held) <= MAX_TILED:
            return
        title = window_title(node)

        if change == "new":
            target = next_empty_workspace(tree, number)
            if target is None:
                note("workspace %d is full and no workspace is empty: %s "
                     "stays floating" % (number, title))
                float_overflow(con_id, number, title,
                               "All ten workspaces already hold a window, so "
                               "there is no empty workspace to move it to. "
                               "Close a window and open it again.")
                return
            own.add(con_id)
            i3.command("[con_id=%d] move --no-auto-back-and-forth container "
                       "to workspace number %d" % (con_id, target))
            # It has to be visible: the point of the overflow is that the
            # program the owner just opened is the one he sees.
            i3.command("workspace --no-auto-back-and-forth number %d" % target)
            i3.command("[con_id=%d] focus" % con_id)
            note("workspace %d was full: %s opened on workspace %d"
                 % (number, title, target))
            return

        # A move (by hand, or the window being tiled again) into a workspace
        # that already holds two: the consistent exception is the same one as
        # exhaustion.  Nothing that was already there is moved.
        note("workspace %d was full: %s stays floating (%s)"
             % (number, title, change))
        own.discard(con_id)
        float_overflow(con_id, number, title,
                       "A workspace holds two windows, so it was not squeezed "
                       "in beside them.")

    i3.message(SUBSCRIBE, json.dumps(["window"]))
    note("subscribed to window events")

    while True:
        try:
            payload = i3.event()
        except (ConnectionError, ValueError) as error:
            note("connection lost (%s), reconnecting" % error)
            time.sleep(2)
            path = find_socket()
            if not path:
                return 1
            i3 = I3(path)
            i3.message(SUBSCRIBE, json.dumps(["window"]))
            continue
        if not isinstance(payload, dict):
            continue
        # No single event may end the helper: the rest of the session would
        # then lose its limit silently.
        try:
            handle(payload)
        except Exception as error:  # noqa: BLE001
            note("event error: %s" % error)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - keep the failure where it can be read
        import traceback
        note("fatal: " + traceback.format_exc().replace("\n", " | "))
        raise
