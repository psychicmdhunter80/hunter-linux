#!/bin/sh
# Hunter Linux 1.0 - start the graphical installer with the privileges it needs.
#
# In the live session the live user has passwordless sudo, so this never asks
# for a password.  On an installed system the installer is not present.

if [ "$(id -u)" -eq 0 ]; then
	exec calamares "$@"
fi

# Calamares runs as root, and the X server only authorised the session user.
# Without this the installer dies with "Authorization required, but no
# authorization protocol specified" and never draws a window.
if [ -n "${DISPLAY:-}" ] && command -v xhost >/dev/null 2>&1; then
	xhost +SI:localuser:root >/dev/null 2>&1 || true
fi

if sudo -n true 2>/dev/null; then
	exec sudo -n calamares "$@"
fi

if command -v pkexec >/dev/null 2>&1; then
	exec pkexec calamares "$@"
fi

echo "hunter-install: cannot obtain administrator privileges." >&2
exit 1
