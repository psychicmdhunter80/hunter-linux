#!/usr/bin/env python3
"""SMD Linux - let xfce4-panel's own auto-hide work under i3.

i3 manages dock windows itself and refuses to move them: its log says "Dock
client will not be moved, we only support moving it to another output" and then
tells the panel it is still visible, so the panel's native auto-hide (which works
by moving itself off screen) can never act.  That is i3 issue 4153 and
xfce4-panel issue 308.

This is the same mechanism the Acer Chromebook installation used
(~/.local/bin/acer-panel): start the real xfce4-panel, then take only its
dock-type windows away from the window manager - set override_redirect and
reparent them to the root window at the position i3 already gave them.  i3
unmanages them, nobody intercepts the panel's own moves any more, and the
"Automatically hide the panel: Always" setting in the panel configuration starts
to work exactly as it does under xfwm4.

Nothing else is touched: no compositor, no second panel, no timer that moves
windows behind the panel's back.  The helper owns the panel process and exits
when it exits, so the shell wrapper can restart it or stop cleanly at logout.
"""

import os
import subprocess
import sys
import time

try:
    from Xlib import X, display
except ImportError:  # pragma: no cover - the wrapper falls back without us
    sys.stderr.write("python3-xlib is not installed\n")
    sys.exit(1)

# How often to look for new dock windows.  The hide/reveal itself is done by the
# panel, not by this loop, so a slow scan costs nothing and cannot fight the
# panel for control.
SCAN_SECONDS = 1.0

ATOM_PID = "_NET_WM_PID"
ATOM_TYPE = "_NET_WM_WINDOW_TYPE"
TYPE_DOCK = "_NET_WM_WINDOW_TYPE_DOCK"


def dock_windows(x_display, root, pid):
    """Top-level dock windows that belong to the panel process."""
    found = []
    try:
        children = root.query_tree().children
    except Exception:
        return found

    pid_atom = x_display.intern_atom(ATOM_PID)
    type_atom = x_display.intern_atom(ATOM_TYPE)

    for window in children:
        try:
            owner = window.get_full_property(pid_atom, X.AnyPropertyType)
            if not owner or owner.value[0] != pid:
                continue
            kinds = window.get_full_property(type_atom, X.AnyPropertyType)
            names = [x_display.get_atom_name(atom) for atom in kinds.value] if kinds else []
            if names and TYPE_DOCK not in names:
                continue
            found.append(window)
        except Exception:
            # A window can vanish between query_tree() and the property read.
            continue
    return found


def detach(x_display, root, window):
    """Take one dock window out of the window manager's control."""
    try:
        geometry = window.get_geometry()
        window.change_attributes(override_redirect=1)
        window.reparent(root, geometry.x, geometry.y)
        window.configure(x=geometry.x, y=geometry.y,
                         width=geometry.width, height=geometry.height)
        window.map()
        return True
    except Exception as error:
        sys.stderr.write("could not detach panel window: %s\n" % error)
        return False


def main():
    panel = subprocess.Popen(
        ["xfce4-panel", "--disable-wm-check"],
        stdout=sys.stdout, stderr=sys.stderr)

    x_display = display.Display()
    root = x_display.screen().root
    handled = set()

    try:
        while True:
            for window in dock_windows(x_display, root, panel.pid):
                key = window.id
                if key in handled:
                    continue
                if detach(x_display, root, window):
                    handled.add(key)
                    sys.stderr.write("detached panel window 0x%x\n" % key)
            x_display.sync()

            if panel.poll() is not None:
                return panel.returncode or 0
            time.sleep(SCAN_SECONDS)
    except KeyboardInterrupt:
        return 0
    finally:
        try:
            if panel.poll() is None:
                panel.terminate()
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
