#!/bin/sh
# SMD Linux - graphical session.
#
# LightDM runs this through /usr/share/xsessions/hunter.desktop, both in the
# live session and on an installed system.  It only sets up the environment and
# hands over to i3: the panel, the applets and the polkit agent are started from
# the i3 configuration (see hunter-panel and hunter-applets), because i3 is the
# one process that is guaranteed to be running on both live and installed
# systems.  Starting them here as well meant they were missing whenever the
# display manager picked a different session file.

export XDG_SESSION_DESKTOP=hunter
export XDG_CURRENT_DESKTOP=HUNTER:XFCE
export DESKTOP_SESSION=hunter
export XDG_SESSION_TYPE=x11

# Create ~/Desktop, ~/Downloads, ~/Documents, ... on first login.
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
	xdg-user-dirs-update
fi

# Booted from the "Install SMD Linux" menu entry?  Open the installer.
if grep -qw 'hunter.installer=1' /proc/cmdline 2>/dev/null; then
	(
		sleep 5
		/usr/local/bin/hunter-install
	) >/dev/null 2>&1 &
fi

# i3 stays in the foreground: when it exits, the session ends.
exec i3
