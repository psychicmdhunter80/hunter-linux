#!/bin/sh
# SMD Linux 1.0 - install GRUB into the freshly unpacked target system.
#
# Calamares' stock bootloader module builds its menu with grub-mkconfig, and
# that generator aborts inside this image's chroot: it dies in its own
# 00_header step before writing a single line, which fails the whole
# installation at the very last stage.  Installing the boot loader and writing
# a complete grub.cfg here keeps an installation from depending on it.
#
# Runs inside the target system, with /dev, /proc, /sys and the EFI system
# partition already mounted by the installer.

set -eu

log() { echo "hunter-bootloader: $*"; }

root_source=$(findmnt -no SOURCE /)
root_uuid=$(findmnt -no UUID /)
[ -n "$root_uuid" ] || root_uuid=$(blkid -s UUID -o value "$root_source")
disk=/dev/$(lsblk -no PKNAME "$root_source" | head -n 1)
log "root filesystem $root_source (uuid $root_uuid) on $disk"

kernel=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n 1) || true
if [ -z "${kernel}" ]; then
	echo "hunter-bootloader: no kernel in /boot" >&2
	exit 1
fi
kernel_name=${kernel#/boot/}
initrd=/boot/initrd.img-${kernel_name#vmlinuz-}
log "kernel ${kernel_name}, initramfs ${initrd}"

write_cfg() {
	cfg=$1
	mkdir -p "$(dirname "${cfg}")"
	cat > "${cfg}" <<EOF
set default=0
set timeout=5
insmod part_gpt
insmod part_msdos
insmod ext2
insmod gzio
insmod all_video
set gfxpayload=keep
search --no-floppy --fs-uuid --set=root ${root_uuid}

menuentry 'SMD Linux' {
	load_video
	linux /boot/${kernel_name} root=UUID=${root_uuid} ro quiet console=ttyS0,115200n8 console=tty0
	initrd ${initrd}
}

menuentry 'SMD Linux (recovery mode)' {
	load_video
	linux /boot/${kernel_name} root=UUID=${root_uuid} ro single console=ttyS0,115200n8 console=tty0
	initrd ${initrd}
}
EOF
	log "wrote ${cfg}"
}

# The installer does not always leave the EFI system partition mounted at
# /boot/efi inside this chroot, so find it on the disk and mount it here.
esp_partition=$(lsblk -no NAME,FSTYPE,PARTTYPE "${disk}" 2>/dev/null |
	awk '$3 ~ /c12a7328-f81f-11d2-ba4b-00a0c93ec93b/ { print $1; exit }')
if [ -z "${esp_partition}" ]; then
	esp_partition=$(lsblk -no NAME,FSTYPE "${disk}" 2>/dev/null |
		awk '$2 == "vfat" { print $1; exit }')
fi

esp=/boot/efi
mounted_here=0
if [ -n "${esp_partition}" ]; then
	if ! mountpoint -q "${esp}" 2>/dev/null; then
		mkdir -p "${esp}"
		mount "/dev/${esp_partition}" "${esp}" && mounted_here=1
	fi
fi

if [ -n "${esp_partition}" ]; then
	log "installing GRUB for UEFI on ${esp} (/dev/${esp_partition})"
	grub-install --target=x86_64-efi --efi-directory="${esp}" \
		--bootloader-id=Hunter_Linux --recheck --no-nvram --force

	id_dir="${esp}/EFI/Hunter_Linux"
	mkdir -p "${id_dir}"
	for name in shimx64.efi mmx64.efi; do
		if [ -f "/usr/lib/shim/${name}.signed" ]; then
			cp -f "/usr/lib/shim/${name}.signed" "${id_dir}/${name}"
			log "installed ${id_dir}/${name}"
		fi
	done
	write_cfg "${id_dir}/grub.cfg"

	# Some firmware only looks at the removable-media path.  shim loads the
	# second stage from the directory it was started from, so grubx64.efi has
	# to sit next to it - without that copy the firmware reports
	# "Failed to open \\EFI\\BOOT\\grubx64.efi" and boots nothing at all.
	mkdir -p "${esp}/EFI/BOOT"
	if [ -f "${id_dir}/shimx64.efi" ]; then
		cp -f "${id_dir}/shimx64.efi" "${esp}/EFI/BOOT/BOOTX64.EFI"
		if [ -f "${id_dir}/mmx64.efi" ]; then
			cp -f "${id_dir}/mmx64.efi" "${esp}/EFI/BOOT/mmx64.efi"
		fi
		if [ -f "${id_dir}/grubx64.efi" ]; then
			cp -f "${id_dir}/grubx64.efi" "${esp}/EFI/BOOT/grubx64.efi"
		fi
		cp -f "${id_dir}/grub.cfg" "${esp}/EFI/BOOT/grub.cfg"
		log "installed the removable-media fallback loader"
	fi

	# A firmware boot entry is a convenience: the fallback above boots
	# without it, and some firmware refuses writes during an installation.
	if efibootmgr -c -d "${disk}" -p 1 -L "SMD Linux" \
		-l '\EFI\Hunter_Linux\shimx64.efi' >/dev/null 2>&1; then
		log "added a firmware boot entry"
	else
		log "could not add a firmware boot entry (fallback loader is in place)"
	fi
else
	log "installing GRUB for BIOS on ${disk}"
	grub-install --target=i386-pc --recheck --force "${disk}"
fi

write_cfg /boot/grub/grub.cfg

if [ "${mounted_here}" = 1 ]; then
	umount "${esp}" 2>/dev/null || true
fi
log "done"
