# Generated by tools/make-assets.py from VERSION - do not edit.
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
Window.SetBackgroundTopColor(0.078, 0.094, 0.114);
Window.SetBackgroundBottomColor(0.125, 0.157, 0.196);

title = Image.Text("SMD LINUX", 0.90, 0.90, 0.92);
subtitle = Image.Text("VERSION 1.6.0", 0.55, 0.62, 0.70);
status = Image.Text("SMD Linux is loading...", 0.62, 0.66, 0.72);

title_sprite = Sprite(title);
title_sprite.SetPosition(screen_width / 2 - title.GetWidth() / 2,
                        screen_height / 2 - title.GetHeight());
subtitle_sprite = Sprite(subtitle);
subtitle_sprite.SetPosition(screen_width / 2 - subtitle.GetWidth() / 2,
                            screen_height / 2 + 6);
status_sprite = Sprite(status);
status_sprite.SetPosition(screen_width / 2 - status.GetWidth() / 2,
                          screen_height - 150);

# Three dots under the status line; one after another lights up, so the screen
# is visibly alive without a spinner animation file.
dot_image = Image.Text(".", 1.0, 1.0, 1.0);
dot_width = dot_image.GetWidth() + 12;
dot_one = Sprite(dot_image);
dot_two = Sprite(dot_image);
dot_three = Sprite(dot_image);
dot_left = screen_width / 2 - dot_width;
dot_y = screen_height - 110;
dot_one.SetPosition(dot_left, dot_y);
dot_two.SetPosition(dot_left + dot_width, dot_y);
dot_three.SetPosition(dot_left + 2 * dot_width, dot_y);

frame = 0;
fun refresh () {
    frame = frame + 1;
    step = (frame / 12) % 4;
    if (step == 1) { dot_one.SetOpacity(1.0); } else { dot_one.SetOpacity(0.25); }
    if (step == 2) { dot_two.SetOpacity(1.0); } else { dot_two.SetOpacity(0.25); }
    if (step == 3) { dot_three.SetOpacity(1.0); } else { dot_three.SetOpacity(0.25); }
}
Plymouth.SetRefreshFunction(refresh);
