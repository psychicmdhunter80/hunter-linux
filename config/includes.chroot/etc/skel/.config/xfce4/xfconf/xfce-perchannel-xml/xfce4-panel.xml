<?xml version="1.0" encoding="UTF-8"?>

<!-- SMD Linux 1.0 - default XFCE panel.
     xfce4-panel 4.16 and later (4.20 in Debian 13) keeps the panel properties
     inside the "panels" array - /panels/panel-1/plugin-ids and friends - and
     the plugin definitions under /plugins/plugin-N.  Panel properties left at
     the top level are ignored and the panel comes up empty, so the nesting
     below is exactly what the running panel itself writes. -->
<channel name="xfce4-panel" version="1.0">
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <!-- The panel is always visible along the bottom edge: 1.3 retired
           auto-hide.  i3 refuses to move dock windows (i3 issue 4153), so the
           panel could only be hidden by helpers fighting the window manager,
           and full-screen video covers the bar anyway. -->
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="disable-struts" type="bool" value="false"/>
      <!-- Solid black panel, readable white text: no theme suite and no
           compositor needed, just the panel's own background settings. -->
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0"/>
        <value type="double" value="0"/>
        <value type="double" value="0"/>
        <value type="double" value="1"/>
      </property>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="mode" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <!-- p=10: bottom edge, centred.  autohide-behavior 2 hides the panel
           always; it slides back up when the pointer reaches the bottom of the
           screen.  i3 keeps the 1px strut the panel leaves behind, so windows
           never end up on a screen that has no panel at all. -->
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="28"/>
      <property name="size-adjust" type="bool" value="false"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="panels-version" type="uint" value="2"/>

  <property name="plugins" type="empty">
    <!-- Application menu -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="smd-menu"/>
      <property name="show-button-title" type="bool" value="false"/>
    </property>

    <!-- Open windows -->
    <property name="plugin-2" type="string" value="tasklist">
      <property name="show-labels" type="bool" value="true"/>
    </property>

    <!-- Spacer, pushes the status items to the right edge -->
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <!-- Workspaces (i3 provides the EWMH workspace list) -->
    <property name="plugin-4" type="string" value="pager">
      <property name="rows" type="uint" value="1"/>
    </property>

    <!-- Status area: NetworkManager and Bluetooth applets -->
    <property name="plugin-5" type="string" value="systray">
      <property name="show-frame" type="bool" value="false"/>
      <property name="size-max" type="uint" value="24"/>
    </property>

    <!-- Clock and date -->
    <property name="plugin-6" type="string" value="clock">
      <property name="digital-format" type="string" value="%H:%M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>

    <!-- Volume -->
    <property name="plugin-7" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
    </property>

    <!-- Battery with percentage (shown only on machines with a battery) -->
    <property name="plugin-8" type="string" value="battery">
      <property name="show-label" type="bool" value="true"/>
      <property name="show-percentage" type="bool" value="true"/>
      <property name="hide-when-full" type="bool" value="false"/>
    </property>

    <!-- Power menu: log out, restart, shut down, lock -->    <property name="plugin-9" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="hunter-power.desktop"/>
      </property>
    </property>
  </property>
</channel>
