<?xml version="1.0" encoding="UTF-8"?>

<!-- SMD Linux 1.0 - default XFCE panel.
     xfce4-panel 4.16 and later (4.20 in Debian 13) keeps the panel properties
     inside the "panels" array - /panels/panel-1/plugin-ids and friends - and
     the plugin definitions under /plugins/plugin-N.  Panel properties left at
     the top level are ignored and the panel comes up empty, so the nesting
     below is exactly what the running panel itself writes. -->
<channel name="xfce4-panel" version="1.0">
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <!-- The panel is always visible along the bottom edge: 1.3 retired
           auto-hide.  i3 refuses to move dock windows (i3 issue 4153), so the
           panel could only be hidden by helpers fighting the window manager,
           and full-screen video covers the bar anyway. -->
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="disable-struts" type="bool" value="false"/>
      <!-- Solid black panel, readable white text: no theme suite and no
           compositor needed, just the panel's own background settings. -->
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0"/>
        <value type="double" value="0"/>
        <value type="double" value="0"/>
        <value type="double" value="1"/>
      </property>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="mode" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <!-- p=10: bottom edge, centred.  autohide-behavior stays 0: the panel
           is always visible, and full-screen video covers it. -->
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="28"/>
      <property name="size-adjust" type="bool" value="false"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
        <value type="int" value="12"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="20"/>
        <value type="int" value="21"/>
        <value type="int" value="22"/>
        <value type="int" value="23"/>
        <value type="int" value="24"/>
        <value type="int" value="25"/>
        <value type="int" value="26"/>
        <value type="int" value="27"/>
        <value type="int" value="28"/>
        <value type="int" value="29"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="panels-version" type="uint" value="2"/>

  <property name="plugins" type="empty">
    <!-- Application menu -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="smd-menu"/>
      <property name="show-button-title" type="bool" value="false"/>
      <!-- Browser, then File Manager, then Terminal, then the installer.
           The installer entry exists only in the live session: it is removed
           from its .desktop file *and* from this list by the installer's
           post-install script, so an installed user has no dangling shortcut
           and no favourite pointing at one. -->
      <property name="favorites" type="array">
        <value type="string" value="brave-browser.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="hunter-install.desktop"/>
      </property>
    </property>

    <!-- A small transparent gap between the menu button and the browser:
         1.4 puts Brave immediately after the S menu, the same place Hunter
         keeps it.  Nonexpanding, so nothing else moves. -->
    <property name="plugin-10" type="string" value="separator">
      <property name="expand" type="bool" value="false"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <!-- Brave, one click away -->
    <property name="plugin-11" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="brave-browser.desktop"/>
      </property>
    </property>

    <!-- File Manager, beside Brave: the second thing Hunter opens -->
    <property name="plugin-12" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="thunar.desktop"/>
      </property>
    </property>

    <!-- Open windows -->
    <property name="plugin-2" type="string" value="tasklist">
      <!-- Icons, not titles: a long page title took half the panel.  The
           window title is still there in the hover tooltip, and every window
           keeps its own button. -->
      <property name="show-labels" type="bool" value="false"/>
      <property name="show-tooltips" type="bool" value="true"/>
      <property name="tooltip-lines" type="uint" value="1"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="window-scrolling" type="bool" value="false"/>
    </property>

    <!-- Spacer, pushes the status items to the right edge -->
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <!-- Workspaces: all ten as numbered buttons, always present even when a
         workspace is empty.  i3 only reports workspaces that exist, and it
         discards an empty one when you leave it, so the panel's built-in
         pager could never show all ten.

         Each workspace is its own launcher plugin with exactly one item.  A
         single launcher holding ten items does NOT draw ten buttons: xfce4-panel
         uses the first item as the button and hides the rest behind an arrow
         (see the 4.20 launcher documentation).  1.7.1 shipped that mistake -
         one button and an overflow arrow - which the 8 August verification
         caught in a screenshot.  One launcher per workspace is what actually
         produces ten buttons.  hunter-workspaces rewrites each .desktop icon
         on every i3 workspace and window event, so a button shows whether its
         workspace holds a window and which one is current. -->
    <property name="plugin-20" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-1.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-21" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-2.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-22" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-3.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-23" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-4.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-24" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-5.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-25" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-6.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-26" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-7.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-27" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-8.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-28" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-9.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-29" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="smd-workspace-10.desktop"/>
      </property>
      <property name="show-labels" type="bool" value="false"/>
    </property>

    <!-- Status area: NetworkManager and Bluetooth applets -->
    <property name="plugin-5" type="string" value="systray">
      <property name="show-frame" type="bool" value="false"/>
      <property name="size-max" type="uint" value="24"/>
    </property>

    <!-- Clock and date -->
    <property name="plugin-6" type="string" value="clock">
      <property name="digital-format" type="string" value="%H:%M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>

    <!-- Volume -->
    <property name="plugin-7" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
    </property>

    <!-- Battery with percentage (shown only on machines with a battery) -->
    <property name="plugin-8" type="string" value="battery">
      <property name="show-label" type="bool" value="true"/>
      <property name="show-percentage" type="bool" value="true"/>
      <property name="hide-when-full" type="bool" value="false"/>
    </property>

    <!-- Power menu: log out, restart, shut down, lock -->    <property name="plugin-9" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="hunter-power.desktop"/>
      </property>
    </property>
  </property>
</channel>
