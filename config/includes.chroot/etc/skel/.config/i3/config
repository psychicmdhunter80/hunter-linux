# SMD Linux - i3 configuration
#
# Modifier: LEFT ALT.  The Chromebook's Search key (Super) is only the
# launcher: pressed on its own it opens the application menu.  Super is kept
# out of the other shortcuts so the browser and the launcher never fight over
# it, and Alt+Left/Right are left to the applications (Firefox back/forward),
# which is why window focus uses Alt+H/J/K/L instead of the arrow keys.
#
# No compositing and no i3bar: the XFCE panel along the bottom edge is the
# taskbar, started here so it exists in the live session and after install.
#
# A one-page cheat sheet is on the desktop and on Alt+F1.

set $mod Mod1
set $term xfce4-terminal

font pango:DejaVu Sans 10

# Window behaviour
floating_modifier $mod
focus_follows_mouse no
workspace_auto_back_and_forth yes
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# ---------------------------------------------------------------------------
# Session processes: panel, applets, polkit agent
# ---------------------------------------------------------------------------
# Both scripts are idempotent, so i3 reloads do not stack panels or applets.
exec_always --no-startup-id hunter-panel
exec_always --no-startup-id hunter-applets

# Chromebook top row.  On a Chromebook the printed dimmer/brighter/mute/volume
# down/volume up keys arrive as F6-F10, not as the XF86 keysyms bound further
# down, so those five function keys are routed through hunter-media: it does
# the printed job on a Chromebook and hands the real F key to the application
# on any other keyboard (hunter-toprow decides which, at session start).
exec --no-startup-id hunter-toprow
bindsym F6 exec --no-startup-id hunter-media brightness-down F6
bindsym F7 exec --no-startup-id hunter-media brightness-up F7
bindsym F8 exec --no-startup-id hunter-media mute F8
bindsym F9 exec --no-startup-id hunter-media volume-down F9
bindsym F10 exec --no-startup-id hunter-media volume-up F10

# The secondary route Hunter suggested: Ctrl plus a top-row key is the real
# function key, always.
bindsym Control+F6 exec --no-startup-id xdotool key --clearmodifiers F6
bindsym Control+F7 exec --no-startup-id xdotool key --clearmodifiers F7
bindsym Control+F8 exec --no-startup-id xdotool key --clearmodifiers F8
bindsym Control+F9 exec --no-startup-id xdotool key --clearmodifiers F9
bindsym Control+F10 exec --no-startup-id xdotool key --clearmodifiers F10


# ---------------------------------------------------------------------------
# Desktop: wallpaper and automatic display detection
# ---------------------------------------------------------------------------
exec_always --no-startup-id feh --no-fehbg --bg-fill /usr/share/backgrounds/smd/smd-linux-wallpaper.png
exec_always --no-startup-id xrandr --auto

# ---------------------------------------------------------------------------
# Launcher
# ---------------------------------------------------------------------------
# Search key on its own.  --release makes it fire when the key comes back up,
# so holding Search as a modifier does not open the menu by accident.
bindsym --release Super_L exec --no-startup-id rofi -show drun
bindsym --release XF86Search exec --no-startup-id rofi -show drun
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Tab exec --no-startup-id rofi -show window

# ---------------------------------------------------------------------------
# Applications
# ---------------------------------------------------------------------------
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+e exec --no-startup-id thunar
bindsym $mod+p exec --no-startup-id xfce4-display-settings --minimal
bindsym $mod+F1 exec --no-startup-id xdg-open /usr/share/doc/hunter-linux/shortcuts.html

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
bindsym $mod+Shift+q kill
bindsym $mod+F4 kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+t layout toggle split

# ---------------------------------------------------------------------------
# Workspaces
# ---------------------------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Control+Right move container to workspace next
bindsym $mod+Control+Left move container to workspace prev

# ---------------------------------------------------------------------------
# Session: power menu, screen lock, reload/restart
# ---------------------------------------------------------------------------
bindsym $mod+Shift+e exec --no-startup-id hunter-power
bindsym XF86PowerOff exec --no-startup-id hunter-power
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1d232b
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ---------------------------------------------------------------------------
# Media and brightness keys (PipeWire via wpctl, backlight via brightnessctl)
# ---------------------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# ---------------------------------------------------------------------------
# Resize mode: Alt+R, then H/J/K/L or the arrow keys, Enter or Escape to leave
# ---------------------------------------------------------------------------
mode "resize" {
	bindsym h resize shrink width 10 px or 10 ppt
	bindsym j resize grow height 10 px or 10 ppt
	bindsym k resize shrink height 10 px or 10 ppt
	bindsym l resize grow width 10 px or 10 ppt
	bindsym Left resize shrink width 10 px or 10 ppt
	bindsym Down resize grow height 10 px or 10 ppt
	bindsym Up resize shrink height 10 px or 10 ppt
	bindsym Right resize grow width 10 px or 10 ppt
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# ---------------------------------------------------------------------------
# Floating windows (dialogs, logout dialogs, file operation windows)
# ---------------------------------------------------------------------------
# The installer is a fixed-size wizard, not a tiled application: float it and
# centre it, otherwise i3 squeezes it into a column and the right-hand side of
# every page is cut off.
for_window [class="calamares"] floating enable, resize set 1010 700, move position center
for_window [class="Calamares"] floating enable, resize set 1010 700, move position center

for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="xfce4-power-manager"] floating enable
for_window [class="Xfce4-power-manager"] floating enable
for_window [class="blueman-manager"] floating enable
