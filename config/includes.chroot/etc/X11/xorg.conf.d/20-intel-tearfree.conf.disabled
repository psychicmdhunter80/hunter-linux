# SMD Linux - optional TearFree for Intel graphics (shipped disabled).
#
# Video tearing while watching YouTube or Jellyfin comes from having no
# compositor under i3.  On Intel GPUs the driver can remove it without one.
# This file is deliberately NOT active: it is Intel-specific and should not be
# forced on every machine that boots this ISO.
#
# Enable on the affected machine only:
#     sudo mv /etc/X11/xorg.conf.d/20-intel-tearfree.conf.disabled \
#             /etc/X11/xorg.conf.d/20-intel-tearfree.conf
#     sudo systemctl restart lightdm
#
# Undo it by moving the file back.  Check which driver is in use with
#     sudo lspci -nnk | grep -A3 VGA
#     grep -i "tearfree" /var/log/Xorg.0.log
#
# The Intel DDX is only selected when it is installed and asked for, so this
# file also pins the driver on purpose.

Section "Device"
	Identifier "Intel Graphics"
	Driver     "intel"
	Option     "TearFree"    "true"
	Option     "AccelMethod" "sna"
EndSection
