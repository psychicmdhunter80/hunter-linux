# SMD Linux - applications.
#
# Browsing, YouTube and Jellyfin on a 2 GB machine.  1.4 makes Brave the
# default browser; it is installed in 0350-smd-browser.hook.chroot from Brave's
# signed repository, because a third-party package cannot be resolved in the
# early package stage.  libavcodec-extra supplies the codecs Brave and VLC use,
# and VLC is the local media player (the video plugin set comes with it).
libavcodec-extra
vlc
# Automatic tiling (hunter-autotile) speaks i3's IPC protocol
# directly, so only Python itself is needed.
python3
unzip
xz-utils

# The Jellyfin client is a Python package, so 0360-smd-clients.hook.chroot
# installs it into its own virtualenv; python3-venv is what builds that
# environment.  mpv is the player it drives, and libmpv2 is the library the
# client loads directly - both are required for playback rather than being a
# general media player on the image.  It is a client only: no server, no
# account, no autostart.
python3-venv
libmpv2
mpv

# Voice Typing's listening/stopped feedback is a desktop notification.
libnotify-bin
