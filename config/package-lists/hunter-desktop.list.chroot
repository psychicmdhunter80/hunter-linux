# SMD Linux - display server, window manager, panel and desktop utilities
#
# Xorg + i3 + xfce4-panel only.  No GNOME, KDE, Cinnamon, MATE and no
# xfce4-session/xfwm4 (the XFCE meta desktop is deliberately not installed).
xserver-xorg
xserver-xorg-video-intel
xserver-xorg-video-amdgpu
xserver-xorg-video-radeon
xserver-xorg-video-nouveau
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xserver-xorg-input-libinput
xserver-xorg-input-synaptics
x11-xserver-utils
x11-utils
xinit
xinput
brightnessctl

# Window manager and session
i3-wm
i3lock
rofi
lightdm
lightdm-gtk-greeter

# Panel and its plugins (no full XFCE desktop)
xfce4-panel
xfce4-settings
xfce4-power-manager
xfce4-power-manager-plugins
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-battery-plugin
xfce4-notifyd
thunar
thunar-volman
thunar-archive-plugin
gvfs
gvfs-fuse
udisks2
xfce4-terminal
mousepad
feh

# Look and feel
adwaita-icon-theme
gnome-themes-extra
librsvg2-common
fonts-dejavu-core
fonts-liberation

# XDG desktop integration (Downloads/Documents folders, default applications)
xdg-utils
xdg-user-dirs
xdg-user-dirs-gtk
