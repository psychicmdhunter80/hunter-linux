# Live, safe-graphics and installer entries (legacy BIOS menu).
#
# live-build expands @FLAVOUR@, @LINUX@ and @INITRD@ in this file only, and
# appends the result to the generated live.cfg.
label live-@FLAVOUR@
	menu label ^Start SMD Linux Live
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-safe
	menu label Start SMD Linux Live (^Safe Graphics)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

# Same live system, but the installer is started automatically once the
# desktop is up (the kernel parameter is read by hunter-session).
label hunter-install
	menu label ^Install SMD Linux
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ hunter.installer=1
