#!/bin/sh
# SMD Linux 1.0 - live-build configuration.
#
# live-build runs this script through `lb build` whenever config/ does not
# exist yet (or after `lb clean`).  Every value below is a deliberate design
# decision; see README.md for the reasoning behind the desktop stack.
#
# Override the Debian mirror without editing this file:
#     HUNTER_MIRROR=http://ftp.de.debian.org/debian/ ./build.sh
set -e

MIRROR="${HUNTER_MIRROR:-http://deb.debian.org/debian/}"
# The release version has exactly one home: the VERSION file at the top
# of the project.  Everything else - the image name, the ISO label, the
# installer strings, the artwork - is derived from it.
VERSION=$(tr -d '[:space:]' < VERSION)
[ -n "$VERSION" ] || { echo "error: VERSION is empty" >&2; exit 1; }
VOLUME=$(printf '%s' "$VERSION" | tr . _)

lb config noauto \
	--mode debian \
	--distribution trixie \
	--parent-distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--image-name "SMD-Linux-v${VERSION}" \
	--linux-flavours amd64 \
	--linux-packages linux-image \
	--bootloaders syslinux,grub-efi \
	--uefi-secure-boot auto \
	--archive-areas "main contrib non-free non-free-firmware" \
	--apt-recommends false \
	--apt-indices false \
	--apt-source-archives false \
	--debian-installer none \
	--memtest none \
	--firmware-chroot false \
	--firmware-binary false \
	--compression xz \
	--checksums sha256 \
	--chroot-filesystem squashfs \
	--initsystem systemd \
	--bootappend-live "boot=live components quiet splash plymouth.ignore-serial-consoles console=ttyS0,115200 hostname=smd username=user autologin" \
	--bootappend-live-failsafe "boot=live components nosplash nomodeset xforcevesa noapic noapm nodma nolapic nosmp vga=788 console=ttyS0,115200 hostname=smd username=user autologin" \
	--iso-application "SMD Linux ${VERSION}" \
	--iso-preparer "SMD Linux build (live-build)" \
	--iso-publisher "SMD Linux Project" \
	--iso-volume "SMD_LINUX_${VOLUME}" \
	--mirror-bootstrap "${MIRROR}" \
	--mirror-chroot "${MIRROR}" \
	--mirror-binary "${MIRROR}" \
	"$@"
