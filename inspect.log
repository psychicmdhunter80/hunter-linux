===== isolinux config on the ISO =====
include menu.cfg
default vesamenu.c32
prompt 0
# 30 second countdown, then the default entry (Hunter Linux Live) boots.
timeout 300
--- live.cfg
# Live, safe-graphics and installer entries (legacy BIOS menu).
#
# live-build expands amd64, /live/vmlinuz and /live/initrd.img in this file only, and
# appends the result to the generated live.cfg.
label live-amd64
	menu label ^Start Hunter Linux Live
	menu default
	linux /live/vmlinuz
	initrd /live/initrd.img
	append boot=live components quiet splash hostname=hunter username=user

label live-amd64-safe
	menu label Start Hunter Linux Live (^Safe Graphics)
	linux /live/vmlinuz
	initrd /live/initrd.img
	append boot=live components nosplash nomodeset xforcevesa noapic noapm nodma nolapic nosmp vga=788 hostname=hunter username=user

# Same live system, but the installer is started automatically once the
# desktop is up (the kernel parameter is read by hunter-session).
label hunter-install
	menu label ^Install Hunter Linux
	linux /live/vmlinuz
	initrd /live/initrd.img
	append boot=live components quiet splash hostname=hunter username=user hunter.installer=1
--- menu.cfg
# Hunter Linux - boot menu screen for the legacy BIOS / CSM path.
#
# live-build substitutes boot=live components quiet splash hostname=hunter username=user and boot=live components nosplash nomodeset xforcevesa noapic noapm nodma nolapic nosmp vga=788 hostname=hunter username=user in every
# *.cfg file here from LB_BOOTAPPEND_LIVE / LB_BOOTAPPEND_LIVE_FAILSAFE
# (see auto/config).  The kernel and initrd paths are literal because
# live-build only expands @LINUX@/@INITRD@ inside live.cfg.in.
menu hshift 0
menu width 82

menu title HUNTER LINUX 1.0
include stdmenu.cfg
include live.cfg

menu begin advanced
	menu label ^Advanced Boot Options
	menu title Advanced Boot Options
	include stdmenu.cfg
	label mainmenu
		menu label ^Back..
		menu exit
	label hunter-verbose
		menu label Start Hunter Linux Live (^verbose boot)
		linux /live/vmlinuz
		initrd /live/initrd.img
		append boot=live components hostname=hunter username=user
	label hunter-toram
		menu label Start Hunter Linux Live entirely in ^RAM (needs ~2 GB RAM)
		linux /live/vmlinuz
		initrd /live/initrd.img
		append boot=live components quiet splash hostname=hunter username=user toram
	label hunter-hdd
		menu label ^Boot from the first hard disk
		localboot 0x80
	# Hardware detection tool from syslinux; the memtest entry is added by
	# live-build only when a memtest image is present (it is not here).
	include utilities.cfg
menu end

menu clear
--- stdmenu.cfg
menu background splash.png
menu color title	* #e6e6e6ff *
menu color border	* #00000000 #00000000 none
menu color sel		* #ffffffff #3d5a80ff *
menu color hotsel	1;7;37;40 #ffffffff #3d5a80ff *
menu color tabmsg	* #a8b3c1ff #00000000 *
menu color help		37;40 #ffdddd00 #00000000 none
menu vshift 12
menu rows 10
menu helpmsgrow 15
# The command line must be at least one line from the bottom.
menu cmdlinerow 16
menu timeoutrow 16
menu tabmsgrow 18
menu tabmsg Press ENTER to boot or TAB to edit a menu entry
===== grub config on the ISO =====
# Hunter Linux 1.0 - GRUB menu, used by the UEFI image (and by GRUB on BIOS).
#
# live-build replaces /live/vmlinuz-6.12.117+deb13-amd64, /live/initrd.img-6.12.117+deb13-amd64, boot=live components quiet splash hostname=hunter username=user and
# boot=live components nosplash nomodeset xforcevesa noapic noapm nodma nolapic nosmp vga=788 hostname=hunter username=user in every *.cfg under binary/boot/grub, so the
# kernel paths always match the kernel actually built into the image.
source /boot/grub/config.cfg

set timeout=30

menuentry "Start Hunter Linux Live" --hotkey=l {
	linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components quiet splash hostname=hunter username=user
	initrd	/live/initrd.img-6.12.117+deb13-amd64
}

menuentry "Start Hunter Linux Live (Safe Graphics)" --hotkey=s {
	linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components nosplash nomodeset xforcevesa noapic noapm nodma nolapic nosmp vga=788 hostname=hunter username=user
	initrd	/live/initrd.img-6.12.117+deb13-amd64
}

menuentry "Install Hunter Linux" --hotkey=i {
	linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components quiet splash hostname=hunter username=user hunter.installer=1
	initrd	/live/initrd.img-6.12.117+deb13-amd64
}

submenu "Advanced Boot Options" --hotkey=a {

	source /boot/grub/theme.cfg

	menuentry "Start Hunter Linux Live (verbose boot)" {
		linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components hostname=hunter username=user
		initrd	/live/initrd.img-6.12.117+deb13-amd64
	}

	menuentry "Start Hunter Linux Live entirely in RAM (needs ~2 GB RAM)" {
		linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components quiet splash hostname=hunter username=user toram
		initrd	/live/initrd.img-6.12.117+deb13-amd64
	}

	if true; then
		menuentry "Verify integrity of the boot medium" --hotkey=v {
			linux	/live/vmlinuz-6.12.117+deb13-amd64 boot=live components   hostname=hunter username=user findiso=${iso_path} verify-checksums
			initrd	/live/initrd.img-6.12.117+deb13-amd64
		}
	fi

	if [ "${grub_platform}" = "efi" ]; then
		menuentry "UEFI Firmware Settings" --hotkey=f {
			fwsetup
		}
	fi

	menuentry "Boot from the first hard disk" {
		if [ "${grub_platform}" = "pc" ]; then
			set root=(hd0)
			chainloader +1
		else
			exit
		fi
	}
}
